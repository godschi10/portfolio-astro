---
import Layout from '../layouts/Layout.astro';
import '../styles/interior.css';
// MP 1692–1714 and 3728–3747. Static preview, not a delivery integration.
const projectTypes = ['Web Development', 'Web Design', 'SEO', 'Consulting', 'Other'];
const budgets = ['Under $500', '$500–$1000', '$1000–$5000', '$5000+', "Let's discuss"];
---
<Layout title="Contact — Gwill Chijioke" description="Contact Gwill by email. Project enquiry fields are an inactive staging preview; no online submission is available.">
<section class="interior contact-page wrap" aria-labelledby="contact-title">
  <h1 id="contact-title">Let's talk.</h1>
  <aside class="draft-notice" aria-labelledby="contact-draft-title">
    <h2 id="contact-draft-title">This page is a draft</h2>
    <p>No form backend is connected. The fields below are a disabled preview: nothing can be entered or sent from this page. To enquire, use the email link or copy the address into your email app.</p>
    <p>Opening your email app does not send a message automatically. No delivery or response time is promised here.</p>
  </aside>
  <div class="contact-grid">
    <div class="contact-details">
      <h2>Email me</h2>
      <a class="text-link" href="mailto:hi@gwillchijioke.com">hi@gwillchijioke.com</a>
      <p>@gwillchijioke</p>
      <p>Availability has not been confirmed. Please email to discuss your project.</p>
      <p>The budget options shown are from the plan, not a price list or confirmed quote.</p>
    </div>
    <div class="contact-preview">
      <p id="contact-preview-help">Preview only — online submission is unavailable. Required fields are marked “required” for the planned form.</p>
      <fieldset disabled aria-describedby="contact-preview-help">
        <legend>Project enquiry preview</legend>
        <label for="contact-name">Name (required)</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
        <label for="contact-email">Email (required)</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
        <label for="contact-project-type">Project type (required)</label>
        <select id="contact-project-type" name="project-type" required>
          <option value="">Select a project type</option>
          {projectTypes.map(type => <option>{type}</option>)}
        </select>
        <label for="contact-budget">Budget range (optional)</label>
        <select id="contact-budget" name="budget">
          <option value="">Select a budget range</option>
          {budgets.map(budget => <option>{budget}</option>)}
        </select>
        <label for="contact-message">Message (required)</label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
        <button class="button" type="button" disabled>Send Message <span aria-hidden="true">→</span></button>
      </fieldset>
    </div>
  </div>
</section>
</Layout>
<style is:global>
.contact-page .contact-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:32px}
.contact-page .contact-details,.contact-page .contact-preview{min-width:0}
.contact-page .contact-details .text-link{margin-bottom:16px}
.contact-page fieldset{min-width:0;margin:0;padding:24px;border:1px solid var(--border);border-radius:4px}
.contact-page legend{padding-inline:8px;font:700 16px/1.7 var(--mono)}
.contact-page label{display:block;margin-bottom:8px;font-weight:600}
.contact-page input,.contact-page select,.contact-page textarea{display:block;width:100%;min-height:48px;margin-bottom:24px;padding:12px;border:1px solid #8c8982;border-radius:4px;font:400 16px/1.5 system-ui,sans-serif;background:var(--canvas);color:var(--muted);opacity:1;-webkit-text-fill-color:var(--muted)}
.contact-page textarea{resize:vertical}
.contact-page button:disabled{width:100%;cursor:not-allowed;background:var(--muted);border-color:var(--muted);transform:none}
@media(min-width:768px){.contact-page .contact-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:48px}}
</style>
