</div></section>
<section class="services-section" aria-labelledby="services-heading"><div class="container">
<div class="section-header"><div><p class="section-title">What I Do</p><h2 id="services-heading" class="section-headline">Services</h2></div><a href={`${base}services/`} class="section-link">All services <span aria-hidden="true">&#x2192;</span></a></div>
<div class="services-list">
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">01</span><span class="service-name">Web Development</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Fast, custom WordPress sites built to perform. Optimised for speed, SEO, and conversion. No page builders — everything is coded.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">02</span><span class="service-name">Web Design</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Clean, intentional design that converts visitors. Mobile-first always. Every element earns its place.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">03</span><span class="service-name">SEO</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Rankings that stick, traffic that grows. Technical SEO, content strategy, and on-page optimisation.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">04</span><span class="service-name">Tech Consulting</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Cloudflare setup, performance audits, stack decisions, WordPress optimisation. Honest advice, no upselling.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
</div>
</div></section>
<section class="about-section section" aria-labelledby="about-heading"><div class="container"><div class="about-inner">
<h2 id="about-heading" class="section-headline about-heading">I&rsquo;m Gwill &mdash;<br>I obsess over the details.</h2>
<div class="about-photo-frame"><picture><source type="image/webp" srcset={`${base}images/gwill-portrait-320.webp 320w, ${base}images/gwill-portrait-640.webp 640w`} sizes="200px" /><img class="about-photo" src={`${base}images/gwill-portrait.png`} alt="Portrait of Gwill Chijioke" width="640" height="640" loading="lazy" decoding="async" /></picture></div>
<div class="about-text"><p>Web developer, designer, and SEO specialist based in Nigeria. I build sites that are fast, ranked, and built to last.</p><a href={`${base}about/`} class="btn btn--secondary">More About Me <span aria-hidden="true">&#x2192;</span></a></div>
</div></div></section>
<section class="blog-preview-section section" aria-labelledby="blog-heading"><div class="container">
<div class="section-header"><div><p class="section-title">Writing</p><h2 id="blog-heading" class="section-headline">Latest from the <em>android blog</em></h2></div><a href="https://androidscroll.com" class="section-link" target="_blank" rel="noopener noreferrer">Visit android blog <span aria-hidden="true">&#x2197;</span></a></div>
<div class="blog-grid" id="android-grid">
{androidPosts.map(post => (
<a href={post.link} class="post-card" target="_blank" rel="noopener noreferrer"><div class="post-card__body"><p class="post-card__category">{post.category}</p><h3 class="post-card__title">{post.title}</h3><span class="sr-only">(opens in new tab)</span><div class="post-card__meta"><span>{post.date}</span></div><span class="post-card__arrow" aria-hidden="true">&#x2192;</span></div></a>
))}
</div>
</div></section>
<section class="blog-preview-section blog-preview-section--finance section" aria-labelledby="finance-heading"><div class="container">
<div class="section-header"><div><p class="section-title">Finance</p><h2 id="finance-heading" class="section-headline">Latest from the <em>finance blog</em></h2></div><a href="https://finance.gwillchijioke.com" class="section-link" target="_blank" rel="noopener noreferrer">Visit finance blog <span aria-hidden="true">&#x2197;</span></a></div>
<div class="blog-grid">
<a href="https://finance.gwillchijioke.com" class="post-card" target="_blank" rel="noopener noreferrer"><div class="post-card__body"><p class="post-card__category">Finance</p><h3 class="post-card__title">Finance posts land here</h3><span class="sr-only">(opens in new tab)</span><span class="post-card__arrow" aria-hidden="true">&#x2192;</span></div></a>
</div>
</div></section>
<script>if(matchMedia('(min-width:1024px)').matches){document.querySelectorAll('.services-list details').forEach(d=>d.open=true)}</script>
<script>(function(){var el=document.getElementById('hero-clock');if(!el)return;function tick(){try{el.textContent=new Date().toLocaleTimeString('en-GB',{timeZone:'Africa/Lagos',hour:'2-digit',minute:'2-digit'})}catch(e){}}tick();setInterval(tick,20000)})();</script>
<script is:inline>(function(){/* ANDROID FEED URL — REPOINT HERE IN ONE LINE (AndroidScroll is leaving WordPress). */
var ANDROID_FEED_URL='https://androidscroll.com/wp-json/wp/v2/posts?per_page=3&orderby=date&order=desc&_embed=wp:term';
var CACHE_KEY='android-posts-v1',CACHE_TS='android-posts-v1-time',CACHE_TTL=3600000;
function decode(s){try{var t=document.createElement('textarea');t.innerHTML=String(s||'');return t.value}catch(e){return String(s||'')}}function fmt(d){try{return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}catch(e){return''}}function cat(p){try{var ts=(p._embedded&&p._embedded['wp:term']&&p._embedded['wp:term'][0])||[];for(var i=0;i<ts.length;i++){if(ts[i].taxonomy==='category')return ts[i].name}return ts.length?ts[0].name:''}catch(e){return''}}
function render(posts){var g=document.getElementById('android-grid');if(!g||!posts||!posts.length)return;while(g.firstChild)g.removeChild(g.firstChild);posts.slice(0,3).forEach(function(p){var a=document.createElement('a');a.href=p.link;a.className='post-card';a.target='_blank';a.rel='noopener noreferrer';var b=document.createElement('div');b.className='post-card__body';var c=document.createElement('p');c.className='post-card__category';c.textContent=p.category||'';var h=document.createElement('h3');h.className='post-card__title';h.textContent=p.title;var s=document.createElement('span');s.className='sr-only';s.textContent='(opens in new tab)';var m=document.createElement('div');m.className='post-card__meta';var d=document.createElement('span');d.textContent=p.date||'';m.appendChild(d);var ar=document.createElement('span');ar.className='post-card__arrow';ar.setAttribute('aria-hidden','true');ar.textContent='\u2192';b.appendChild(c);b.appendChild(h);b.appendChild(s);b.appendChild(m);b.appendChild(ar);a.appendChild(b);g.appendChild(a)})}
function map(j){return((Array.isArray(j)?j:[]).map(function(p){return{title:decode(p.title&&p.title.rendered),link:p.link,date:fmt(p.date),category:decode(cat(p))}}).filter(function(p){return p.title&&p.link})).slice(0,3)}
function readCache(){try{var t=+localStorage.getItem(CACHE_TS);if(!t||Date.now()-t>CACHE_TTL)return null;var raw=localStorage.getItem(CACHE_KEY);if(!raw)return null;var p=JSON.parse(raw);return(p&&p.length)?p:null}catch(e){return null}}function writeCache(p){try{localStorage.setItem(CACHE_KEY,JSON.stringify(p));localStorage.setItem(CACHE_TS,String(Date.now()))}catch(e){}}
function fetchLive(){try{var cached=readCache();if(cached)render(cached);fetch(ANDROID_FEED_URL).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(j){var m=map(j);if(m.length){writeCache(m);render(m)}}).catch(function(){/* built-in cards stay silently */})}catch(e){/* built-in cards stay silently */}}
/* PageSpeed: the island fetch never blocks LCP — the network fires only when the grid nears the viewport (lazy) with an idle-callback fallback and an 8s safety kick, whichever comes first. Preconnect in <head> still pays (same origin, just deferred). */
var islandStarted=false;function kickIsland(){if(islandStarted)return;islandStarted=true;fetchLive()}
try{var islandGrid=document.getElementById('android-grid'),islandSeen=false;function idleKick(){try{if('requestIdleCallback' in window){requestIdleCallback(kickIsland,{timeout:5000})}else{setTimeout(kickIsland,2000)}}catch(e){setTimeout(kickIsland,2000)}}
if(islandGrid&&'IntersectionObserver' in window){var islandIO=new IntersectionObserver(function(es){for(var i=0;i<es.length;i++){if(es[i].isIntersecting){islandSeen=true;try{islandIO.disconnect()}catch(x){}kickIsland()}}},{rootMargin:'800px'});islandIO.observe(islandGrid);setTimeout(function(){if(!islandSeen){try{islandIO.disconnect()}catch(x){}idleKick()}},8000)}else{idleKick()}}catch(e){setTimeout(kickIsland,2000)}})();</script>
</Layout>
