---
const title = "Gwill Chijioke — Web Design & Development";
const description = "Web design and development studio. Built to mean business.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="deployment" content="GitHub Pages staging — not production" />
  <base href={`${import.meta.env.BASE_URL}/`} />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ivory: #FDFBF7;
      --ink: #111111;
      --violet: #5C3D99;
      --faint: #E8E4DE;
      --ghost: rgba(17,17,17,0.06);
      --max-w: 1120px;
      --gutter: 24px;
    }

    @media (min-width: 768px) { :root { --gutter: 40px; } }

    @media (prefers-color-scheme: dark) {
      :root {
        --ivory: #111111;
        --ink: #F0ECE4;
        --faint: #2A2A2A;
        --ghost: rgba(240,236,228,0.06);
      }
    }

    html { font-size: 16px; scroll-behavior: smooth; }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--ivory);
      color: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* Skip link */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      z-index: 100;
      background: var(--ink);
      color: var(--ivory);
      padding: 8px 16px;
      font-size: 0.875rem;
      font-weight: 600;
    }
    .skip-link:focus {
      left: 16px;
      top: 16px;
      outline: 3px solid var(--violet);
      outline-offset: 2px;
    }

    /* Focus rings */
    :focus-visible {
      outline: 3px solid var(--violet);
      outline-offset: 2px;
    }

    .container {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }

    /* ─── HEADER ─── */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--ivory);
      border-bottom: 1px solid var(--faint);
    }
    @media (prefers-color-scheme: dark) {
      .site-header { background: var(--ivory); }
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .logo {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .nav { display: flex; gap: 32px; }
    .nav a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--ink);
      opacity: 0.7;
      transition: opacity 0.15s ease;
    }
    .nav a:hover, .nav a:focus { opacity: 1; }
    @media (max-width: 479px) {
      .nav { gap: 20px; }
      .nav a { font-size: 0.8125rem; }
    }

    /* ─── HERO ─── */
    .hero {
      padding: 80px 0 96px;
    }
    @media (min-width: 768px) {
      .hero { padding: 100px 0 120px; }
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
    }
    @media (min-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
      }
    }
    @media (min-width: 1280px) {
      .hero-grid { gap: 64px; }
    }

    /* Left panel */
    .eyebrow {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--violet);
      margin-bottom: 24px;
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
    }
    @media (min-width: 768px) {
      .hero h1 { font-size: 3.25rem; }
    }
    @media (min-width: 1280px) {
      .hero h1 { font-size: 4rem; }
    }
    .intro {
      font-size: 1.0625rem;
      line-height: 1.65;
      max-width: 480px;
      margin-bottom: 40px;
      opacity: 0.85;
    }
    .cta-group {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }
    .cta {
      display: inline-block;
      padding: 14px 28px;
      font-size: 0.9375rem;
      font-weight: 600;
      border: 2px solid var(--ink);
      background: var(--ink);
      color: var(--ivory);
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .cta:hover { background: var(--violet); border-color: var(--violet); }
    .cta:focus-visible {
      outline: 3px solid var(--violet);
      outline-offset: 2px;
    }
    .cta-outline {
      background: transparent;
      color: var(--ink);
    }
    .cta-outline:hover {
      background: var(--violet);
      border-color: var(--violet);
      color: var(--ivory);
    }
    @media (max-width: 479px) {
      .cta { padding: 12px 20px; font-size: 0.875rem; }
    }

    /* Right panel — GC letterform */
    .letterform-panel {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .letterform-composition {
      width: 100%;
      max-width: 420px;
      aspect-ratio: 1 / 1;
      border: 1px solid var(--faint);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: var(--ghost);
    }
    .letterform-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .letter-g {
      font-size: 10rem;
      font-weight: 900;
      line-height: 0.85;
      letter-spacing: -0.06em;
      color: var(--ink);
    }
    @media (min-width: 768px) {
      .letter-g { font-size: 14rem; }
    }
    .letter-c {
      font-size: 6rem;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      color: var(--violet);
      align-self: flex-end;
      margin-top: -0.15em;
      margin-right: 0.08em;
    }
    @media (min-width: 768px) {
      .letter-c { font-size: 8rem; }
    }
    .study-label {
      position: absolute;
      bottom: 16px;
      left: 16px;
      right: 16px;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.45;
      text-align: center;
    }
    @media (max-width: 479px) {
      .letterform-composition { max-width: 280px; }
      .letter-g { font-size: 8rem; }
      .letter-c { font-size: 4.5rem; }
    }

    /* ─── FOOTER ─── */
    .site-footer {
      border-top: 1px solid var(--faint);
      padding: 40px 0;
    }
    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .footer-note {
      font-size: 0.8125rem;
      opacity: 0.5;
    }
    .footer-contact a {
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--violet);
    }
    .footer-contact a:hover { text-decoration: underline; }
    /* Review fixes: compact header, bounded art, accessible controls. */
    .nav a, .logo { min-height:44px; display:inline-flex; align-items:center; }
    .letterform-composition { padding:24px 16px 64px; }
    .letter-g { font-size:clamp(100px,15vw,180px); }
    .letter-c { font-size:clamp(60px,8vw,100px); }
    .study-label { opacity:.8; }
    .footer-note { opacity:.75; }
    #work { padding-bottom:28px; font-size:14px; }
    .cta:hover { background:#5C3D99; border-color:#5C3D99; color:#fff; }
    @media(max-width:479px) { .logo { font-size:12px; letter-spacing:.02em; } .nav { gap:12px; } }
    @media(prefers-color-scheme:dark) { :root { --violet:#BFA5FF; } }
    @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; } }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a href={import.meta.env.BASE_URL} class="logo" aria-label="Gwill Chijioke — Home">Gwill Chijioke</a>
      <nav class="nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="mailto:hi@gwillchijioke.com">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Web Design + Development</p>
          <h1>Your next website.<br />Built to mean business.</h1>
          <p class="intro">
            I design and build websites that look right, load fast, and turn visitors into clients.
            No templates, no filler — just focused craft for people who care about the details.
          </p>
          <div class="cta-group">
            <a href="#work" class="cta">Explore my work</a>
            <a href="mailto:hi@gwillchijioke.com" class="cta cta-outline">Let us talk</a>
          </div>
        </div>

        <div class="letterform-panel">
          <div class="letterform-composition" role="img" aria-label="GC monogram design study — not a client project">
            <div class="letterform-inner">
              <span class="letter-g">G</span>
              <span class="letter-c">C</span>
            </div>
            <span class="study-label">Design Study — Not a Client Project</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pending: Work section -->
    <section id="work" class="container" aria-label="Work — pending">
      <p>Selected work — next section to be designed.</p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-note">Header and hero concept only — draft copy.</span>
      <span class="footer-contact">
        <a href="mailto:hi@gwillchijioke.com">hi@gwillchijioke.com</a>
      </span>
    </div>
  </footer>
</body>
</html>
