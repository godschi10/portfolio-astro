---
import Layout from '../layouts/Layout.astro';
import { studies } from '../data/work';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = "Gwill Chijioke — Web Design, Development & SEO";
const description = "I'm Gwill. Design, development and search. One person thinking about the whole website.";
const yrs = Math.max(1, new Date().getFullYear() - 2019 - (new Date().getMonth() < 7 ? 1 : 0));
// Homepage Android section pulls the latest posts AUTOMATICALLY at build time
// (King order). Graceful fallback: last-verified real trio (2026-09-18) —
// genuine titles/permalinks/dates, used only if the feed is unreachable.
const ANDROID_FEED = 'https://androidscroll.com/wp-json/wp/v2/posts?per_page=3&_embed=wp:term&orderby=date&order=desc';
const decodeEntities = (s) => s.replace(/&#(\d+);/g, (_, n) => String.fromCharCode(+n)).replace(/&#x([0-9a-fA-F]+);/g, (_, h) => String.fromCharCode(parseInt(h, 16))).replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&apos;/g, "'");
const formatPostDate = (d) => { try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }); } catch { return ''; } };
const postCategory = (p) => { try { const terms = p._embedded?.['wp:term']?.[0] ?? []; return (terms.find(t => t.taxonomy === 'category') ?? terms[0])?.name ?? ''; } catch { return ''; } };
const androidFallback = [
  { title: 'Check Battery Health Android: 5 Tests That Work (2026)', link: 'https://androidscroll.com/test-phone-battery-health/', date: 'Sep 17, 2026', category: 'Guides & How-tos' },
  { title: 'Samsung Secret Codes: 9 Safe Tests for Galaxy (2026)', link: 'https://androidscroll.com/samsung-secret-codes-test-phone/', date: 'Sep 16, 2026', category: 'Guides & How-tos' },
  { title: 'How to Test Used Phone: 9 Checks in 5 Minutes (2026)', link: 'https://androidscroll.com/how-to-test-used-phone/', date: 'Sep 16, 2026', category: 'Guides & How-tos' },
];
let androidPosts = androidFallback;
try {
  const feedRes = await fetch(ANDROID_FEED);
  if (feedRes.ok) {
    const mapped = (await feedRes.json())
      .map(p => ({ title: decodeEntities(p.title?.rendered ?? ''), link: p.link, date: formatPostDate(p.date), category: decodeEntities(postCategory(p)) }))
      .filter(p => p.title && p.link);
    if (mapped.length) androidPosts = mapped;
  }
} catch { /* feed unreachable at build — honest cached fallback above */ }
---
<Layout title={title} description={description} preconnect="https://androidscroll.com">
<section class="hero" aria-labelledby="hero-title"><div class="wrap">
<div class="hero-grid">
