---
import Layout from '../layouts/Layout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = "Gwill Chijioke — Web Design, Development & SEO";
const description = "I'm Gwill. Design, development and search. One person thinking about the whole website.";
---
<Layout title={title} description={description}>
<section class="hero" aria-labelledby="hero-title"><div class="wrap">
<div class="hero-grid">
<p class="intro"><strong>I'm Gwill.</strong> <span class="roles">Web dev · Designer · SEO</span></p>
<h1 id="hero-title"><span class="line">I design.</span> <span class="line">I build.</span> <span class="line rank"><span class="rank-text">I make it rank.</span><span class="cursor" aria-hidden="true"></span></span></h1>
<figure class="folio" aria-label="Illustrated source comment: turning ideas into fast, ranked websites. Design for people, build for speed, structure for search. Not a running terminal.">
<div class="code-panel"><div class="code-bar"><span><span class="code-icon" aria-hidden="true">&lt;/&gt;</span> approach.html</span><span aria-hidden="true">—</span></div>
<div class="code-body"><p class="comment"><span class="syntax">&lt;!--</span><span class="comment-content">turning ideas into fast, ranked websites</span><span class="syntax">--&gt;</span></p><div class="code-rule" aria-hidden="true"></div><dl class="intent"> <div><dt>01</dt><dd>Design<span class="note">for people.</span></dd></div> <div><dt>02</dt><dd>Build<span class="note">for speed.</span></dd></div> <div><dt>03</dt><dd>Structure<span class="note">for search.</span></dd></div></dl></div>
<figcaption class="code-caption"><span>Intent, not output.</span><span class="signature">// Gwill</span></figcaption></div></figure>
<div class="hero-actions"><a class="button secondary" href={`${base}work/`}>View Work <span aria-hidden="true">↓</span></a><a class="button" href={`${base}contact/`}>Hire Me <span class="arrow" aria-hidden="true">→</span></a></div>
<div class="hero-meta"><span>Anambra, NG</span><span>UTC+1</span><span id="hero-clock" aria-label="Local time in Anambra">--:--</span></div>
</div>
<a href="#work" class="hero-scroll-hint" aria-label="Scroll to work"><span>Scroll</span><span class="hero-scroll-line" aria-hidden="true"></span></a>
</div></section>
<div class="marquee-section" aria-hidden="true"><div class="marquee-track"><span class="marquee-item">WordPress</span><span class="marquee-sep">·</span><span class="marquee-item">SEO</span><span class="marquee-sep">·</span><span class="marquee-item">Web Design</span><span class="marquee-sep">·</span><span class="marquee-item">Cloudflare</span><span class="marquee-sep">·</span><span class="marquee-item">Performance</span><span class="marquee-sep">·</span><span class="marquee-item">Branding</span><span class="marquee-sep">·</span><span class="marquee-item">Custom Themes</span><span class="marquee-sep">·</span><span class="marquee-item">PHP</span><span class="marquee-sep">·</span><span class="marquee-item">Accessibility</span><span class="marquee-sep">·</span><span class="marquee-item">Core Web Vitals</span><span class="marquee-sep">·</span><span class="marquee-item">WordPress</span><span class="marquee-sep">·</span><span class="marquee-item">SEO</span><span class="marquee-sep">·</span><span class="marquee-item">Web Design</span><span class="marquee-sep">·</span><span class="marquee-item">Cloudflare</span><span class="marquee-sep">·</span><span class="marquee-item">Performance</span><span class="marquee-sep">·</span><span class="marquee-item">Branding</span><span class="marquee-sep">·</span><span class="marquee-item">Custom Themes</span><span class="marquee-sep">·</span><span class="marquee-item">PHP</span><span class="marquee-sep">·</span><span class="marquee-item">Accessibility</span><span class="marquee-sep">·</span><span class="marquee-item">Core Web Vitals</span></div></div>
<section class="work-section section" id="work" aria-labelledby="work-heading"><div class="container">
<div class="section-header"><div><p class="section-title">Selected Work</p><h2 id="work-heading" class="section-headline">What I&rsquo;ve <em>built</em></h2></div><a href={`${base}work/`} class="section-link">All projects <span aria-hidden="true">&#x2192;</span></a></div>
<div class="work-grid">
<article class="work-card"><div class="work-card__frame"><div class="work-card__frame-bar" aria-hidden="true"><span class="work-card__frame-dot work-card__frame-dot--purple"></span><span class="work-card__frame-dot work-card__frame-dot--green"></span><span class="work-card__frame-dot work-card__frame-dot--dim"></span><span class="work-card__frame-url">gwillchijioke.com/work</span><span class="work-card__index">01</span></div><div class="work-card__image-wrap work-card__image-wrap--hold"><span>Screenshot lands with the case study</span></div></div><div class="work-card__body"><div class="work-card__tags"><span class="tag">WordPress</span><span class="tag">SEO</span><span class="tag">Design</span></div><h3 class="work-card__name">Project 1 — unnamed placeholder</h3><p class="work-card__desc">Case study lands with real project content.</p><a class="work-card__cta section-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">&#x2192;</span></a></div></article>
<article class="work-card"><div class="work-card__frame"><div class="work-card__frame-bar" aria-hidden="true"><span class="work-card__frame-dot work-card__frame-dot--purple"></span><span class="work-card__frame-dot work-card__frame-dot--green"></span><span class="work-card__frame-dot work-card__frame-dot--dim"></span><span class="work-card__frame-url">gwillchijioke.com/work</span><span class="work-card__index">02</span></div><div class="work-card__image-wrap work-card__image-wrap--hold"><span>Screenshot lands with the case study</span></div></div><div class="work-card__body"><div class="work-card__tags"><span class="tag">Design</span><span class="tag">Build</span></div><h3 class="work-card__name">Project 2 — unnamed placeholder</h3><p class="work-card__desc">Case study lands with real project content.</p><a class="work-card__cta section-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">&#x2192;</span></a></div></article>
<article class="work-card"><div class="work-card__frame"><div class="work-card__frame-bar" aria-hidden="true"><span class="work-card__frame-dot work-card__frame-dot--purple"></span><span class="work-card__frame-dot work-card__frame-dot--green"></span><span class="work-card__frame-dot work-card__frame-dot--dim"></span><span class="work-card__frame-url">gwillchijioke.com/work</span><span class="work-card__index">03</span></div><div class="work-card__image-wrap work-card__image-wrap--hold"><span>Screenshot lands with the case study</span></div></div><div class="work-card__body"><div class="work-card__tags"><span class="tag">SEO</span><span class="tag">Performance</span></div><h3 class="work-card__name">Project 3 — unnamed placeholder</h3><p class="work-card__desc">Case study lands with real project content.</p><a class="work-card__cta section-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">&#x2192;</span></a></div></article>
</div>
</div></section>
<section class="services-section" aria-labelledby="services-heading"><div class="container">
<div class="section-header"><div><p class="section-title">What I Do</p><h2 id="services-heading" class="section-headline">Services</h2></div><a href={`${base}services/`} class="section-link">All services <span aria-hidden="true">&#x2192;</span></a></div>
<div class="services-list">
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">01</span><span class="service-name">Web Development</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Fast, custom WordPress sites built to perform. Optimised for speed, SEO, and conversion. No page builders — everything is coded.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">02</span><span class="service-name">Web Design</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Clean, intentional design that converts visitors. Mobile-first always. Every element earns its place.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">03</span><span class="service-name">SEO</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Rankings that stick, traffic that grows. Technical SEO, content strategy, and on-page optimisation.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
<details class="service-item"><summary class="service-trigger"><span class="service-num" aria-hidden="true">04</span><span class="service-name">Tech Consulting</span><span class="service-icon" aria-hidden="true">&#x2197;</span></summary><div class="service-content"><p class="service-desc">Cloudflare setup, performance audits, stack decisions, WordPress optimisation. Honest advice, no upselling.</p><a href={`${base}contact/`} class="btn btn--secondary">Get a Quote <span aria-hidden="true">&#x2192;</span></a></div></details>
</div>
</div></section>
<section class="about-section section" aria-labelledby="about-heading"><div class="container"><div class="about-inner">
<h2 id="about-heading" class="section-headline about-heading">I&rsquo;m Gwill &mdash;<br>I obsess over the details.</h2>
<div class="about-photo-frame"><div class="about-photo about-photo--hold" role="img" aria-label="Portrait of Gwill Chijioke — photo lands with production"><span>G<span class="dot">.</span></span></div></div>
<div class="about-text"><p>Web developer, designer, and SEO specialist based in Nigeria. I build sites that are fast, ranked, and built to last.</p><a href={`${base}about/`} class="btn btn--secondary">More About Me <span aria-hidden="true">&#x2192;</span></a></div>
</div></div></section>
<section class="blog-preview-section section" aria-labelledby="blog-heading"><div class="container">
<div class="section-header"><div><p class="section-title">Writing</p><h2 id="blog-heading" class="section-headline">Latest from the <em>tech blog</em></h2></div><a href="https://tech.gwillchijioke.com" class="section-link" target="_blank" rel="noopener noreferrer">Visit tech blog <span aria-hidden="true">&#x2197;</span></a></div>
</div></section>
<script>if(matchMedia('(min-width:1024px)').matches){document.querySelectorAll('.services-list details').forEach(d=>d.open=true)}</script>
<script>(function(){var el=document.getElementById('hero-clock');if(!el)return;function tick(){try{el.textContent=new Date().toLocaleTimeString('en-GB',{timeZone:'Africa/Lagos',hour:'2-digit',minute:'2-digit'})}catch(e){}}tick();setInterval(tick,20000)})();</script>
</Layout>
<style is:global>
.hero{position:relative;isolation:isolate;padding-top:40px;padding-bottom:40px;scroll-margin-top:96px}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}.intro{margin:0;font:400 16px/1.7 var(--mono);color:var(--muted)}.intro strong{color:var(--ink);font-weight:700}.intro .roles{display:block}.intro::before{content:"";display:block;width:40px;height:3px;background:var(--purple);margin-bottom:16px}h1{margin:0;font-family:var(--mono);font-weight:800;font-size:clamp(36px,8vw,96px);line-height:1.08;letter-spacing:-.04em;font-feature-settings:"kern" 1,"liga" 1,"calt" 1}h1 .line{display:block}.rank{color:var(--purple);position:relative}.rank-text{background:linear-gradient(110deg,#7c3aed 10%,#087b48 100%);background-clip:text;-webkit-background-clip:text;color:transparent}.cursor{display:inline-block;width:.09em;height:.72em;margin-left:.1em;background:var(--purple);vertical-align:-.02em;animation:blink 1.4s step-end infinite}.hero-actions{display:flex;flex-direction:column;gap:12px;align-items:stretch;align-self:start}.hero-actions .button{width:100%}.hero-meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin:4px 0 0;font:400 13px/2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.hero-meta #hero-clock{color:var(--purple);font-weight:700}.hero-scroll-hint{display:inline-flex;align-items:center;gap:12px;margin-top:28px;min-height:48px;font:700 12px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--muted);text-decoration:none}.hero-scroll-line{display:inline-block;width:48px;height:2px;background:var(--purple)}
.folio{position:relative;margin:0;min-width:0;padding:0 0 12px 0}.folio::before{content:"";position:absolute;inset:12px 0 0 12px;background:#e8e4ef;border:1px solid #cfc8dc;border-radius:6px;z-index:-1}.code-panel{border-radius:6px;border:1px solid #37323e;background:#17141c;color:#f7f6f3;box-shadow:0 16px 32px #25153b12;overflow:hidden}.code-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 20px;background:#232029;border-bottom:1px solid #443e4b;font:400 16px/1.5 var(--mono);color:#d1c9dc}.code-bar .code-icon{color:#b99be9;font-weight:700}.code-body{padding:24px 20px 20px;font:400 16px/1.7 var(--mono)}.comment{color:#d6ccdf;margin:0;overflow-wrap:anywhere}.syntax{color:#c1a0fa}.comment-content{display:block;padding-left:16px;margin-block:8px}.code-rule{height:1px;background:#443e4b;margin:24px 0 20px}.intent{display:grid;gap:12px;margin:0}.intent div{display:grid;grid-template-columns:32px 1fr;gap:12px}.intent dt{font-weight:700;color:#93deb5}.intent dd{margin:0;color:#f7f6f3}.intent .note{display:block;color:#c2bacb}.code-caption{padding:14px 20px;border-top:1px solid #443e4b;margin:0;font:400 16px/1.5 var(--mono);color:#c2bacb;display:flex;justify-content:space-between;gap:8px}.code-caption .signature{color:#93deb5}
@media(min-width:768px){.hero{padding-top:64px;padding-bottom:48px}.hero-grid{gap:32px}.intro .roles{display:inline}.intro .roles::before{content:" / ";color:#767069}.hero-actions{flex-direction:row;gap:16px}.hero-actions .button{width:auto;min-width:192px}.folio{max-width:640px;width:100%}.code-body{padding:28px}.intent{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.intent div{display:block}.intent dt{margin-bottom:8px}.code-bar,.code-caption{padding-inline:28px}}
@media(min-width:1024px){.hero{padding-top:72px;padding-bottom:40px}.hero-grid{grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);column-gap:48px;row-gap:24px}.intro{grid-column:1/-1}h1{grid-column:1;grid-row:2}.folio{grid-column:2;grid-row:2/5;align-self:center;margin-top:16px;margin-left:32px;padding-bottom:16px}.hero-actions{grid-column:1;grid-row:3;margin-top:8px}.hero-meta{grid-column:1;grid-row:4}.intent{grid-template-columns:1fr;gap:20px}.intent div{display:grid}.intent dt{margin:0}.code-body{padding:28px 24px}.code-bar,.code-caption{padding-inline:24px}.code-caption{flex-wrap:wrap}}
@media(max-width:767px){.code-body{padding:16px 20px}.comment-content{display:inline;padding:0;margin:0}.code-rule{margin:16px 0}.intent{gap:8px}.intent .note{display:inline;margin-left:8px}.code-caption{padding:10px 20px}.code-bar{padding:10px 20px}.hero-actions{align-self:start}.hero-grid{row-gap:24px}}
@media(max-width:359px){.hero{padding-top:32px}.hero .rank{max-width:100%}.cursor{display:none}}
:root{--font-body:"NairaSign",-apple-system,"Segoe UI",Roboto,sans-serif;--text:#0d0d0d;--text-mid:#3a3a3a;--text-dim:#6e6e6e;--bg:#f7f6f3;--surface:#fff;--border-dark:#d4d0c8;--purple-light:rgba(124,58,237,.08);--radius-md:8px;--radius-lg:12px;--radius-full:9999px;--shadow-md:0 4px 12px rgba(0,0,0,.08),0 8px 24px rgba(0,0,0,.06);--shadow-lg:0 8px 32px rgba(0,0,0,.1),0 16px 48px rgba(0,0,0,.08);--t-slow:400ms ease;--space-1:4px;--space-8:96px}
.btn--primary{background:var(--text);color:var(--bg);border-color:var(--text)}.btn--primary:hover{background:var(--purple);border-color:var(--purple);color:#fff}.btn--secondary{background:transparent;color:var(--text);border-color:var(--border-dark)}.btn--secondary:hover{background:var(--text);color:var(--bg);border-color:var(--text)}
.container{width:100%;max-width:var(--wide-width);margin-inline:auto;padding-inline:16px;padding-inline:clamp(16px,5vw,80px)}.section{padding-block:48px;padding-block:clamp(48px,8vw,128px)}
.section-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:var(--space-6);gap:var(--space-4);flex-wrap:wrap}.section-title{font-family:var(--mono);font-size:11px;font-size:clamp(11px,1.2vw,13px);font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim);margin:0 0 var(--space-2)}.section-headline{font-family:var(--mono);font-size:24px;font-size:clamp(24px,3.5vw,40px);font-weight:700;letter-spacing:-.03em;color:var(--text);margin:0}.section-headline em{font-style:normal;color:var(--purple)}.section-link{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--text-dim);text-decoration:none;display:inline-flex;align-items:center;gap:var(--space-1);white-space:nowrap;flex-shrink:0;min-height:48px}.section-link:hover{color:var(--purple)}
.marquee-section{position:relative;background:var(--text);padding-block:14px;overflow:hidden;border-block:1px solid rgba(255,255,255,.04)}.marquee-section::after{content:'';position:absolute;inset:0;background-image:var(--noise);pointer-events:none}.marquee-track{display:flex;gap:var(--space-7);width:max-content;animation:marquee 35s linear infinite}.marquee-section:hover .marquee-track{animation-play-state:paused}@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}.marquee-item{font-family:var(--mono);font-size:13px;font-weight:600;letter-spacing:.12em;color:rgba(247,246,243,.55);white-space:nowrap;text-transform:uppercase}.marquee-item:nth-child(4n+1){background:var(--gradient-brand);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}.marquee-sep{color:var(--purple);font-size:18px;line-height:1;opacity:.7}
.work-section{padding-block:64px;padding-block:clamp(64px,8vw,128px);background:var(--bg)}.work-grid{display:grid;grid-template-columns:1fr;gap:var(--space-4)}@media(min-width:768px){.work-grid{grid-template-columns:1fr 1fr}.work-card:first-child{grid-column:1/-1}}.work-card{position:relative;overflow:hidden;border-radius:var(--radius-lg);border:1px solid var(--border);background:var(--surface);transition:box-shadow var(--t-base),transform var(--t-base)}.work-card__frame{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}.work-card__frame-bar{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg);border-bottom:1px solid var(--border)}.work-card__frame-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}.work-card__frame-dot--purple{background:var(--purple);opacity:.85}.work-card__frame-dot--green{background:var(--green);opacity:.85}.work-card__frame-dot--dim{background:var(--border-dark)}.work-card__frame-url{flex:1;font-family:var(--mono);font-size:10px;color:var(--text-dim);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.work-card__index{display:inline-flex;align-items:center;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--purple);background:var(--surface);border:1px solid rgba(124,58,237,.35);border-radius:var(--radius-full);padding:3px 9px;margin-left:auto}.work-card__image-wrap{min-height:180px;aspect-ratio:16/9;overflow:hidden;background:var(--border)}.work-card:first-child .work-card__image-wrap{aspect-ratio:21/9}@media(max-width:767px){.work-card:first-child .work-card__image-wrap{aspect-ratio:16/9}}.work-card__image-wrap--hold{display:flex;align-items:center;justify-content:center;padding:var(--space-4)}.work-card__image-wrap--hold span{font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--text-dim);text-align:center}.work-card__body{padding:var(--space-4) var(--space-5) var(--space-5)}.work-card__tags{display:flex;flex-wrap:wrap;gap:var(--space-1);margin-bottom:14px}.tag{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:3px 10px;border-radius:var(--radius-sm);background:var(--purple-light);color:var(--purple);border:1px solid rgba(124,58,237,.15)}.work-card__name{font-family:var(--mono);font-size:16px;font-size:clamp(16px,1.8vw,20px);font-weight:700;letter-spacing:-.02em;color:var(--text);margin:0 0 6px}.work-card__desc{font-size:16px;color:var(--text-dim);line-height:1.6;margin:0 0 12px}.work-card__cta{font-size:14px}
.services-section{padding-block:64px;padding-block:clamp(64px,8vw,128px) clamp(24px,3vw,48px);background:var(--surface);border-top:1px solid var(--border)}.services-list{margin-top:0;overflow:clip}.service-item{border-bottom:1px solid var(--border)}.service-item:first-child{border-top:1px solid var(--border)}.service-item:last-child{border-bottom:none}.service-trigger{display:grid;grid-template-columns:40px 1fr auto;gap:var(--space-3);width:100%;padding-block:var(--space-5);align-items:center;list-style:none;cursor:pointer}@media(min-width:600px){.service-trigger{grid-template-columns:56px 1fr auto;gap:var(--space-4)}}.service-trigger::-webkit-details-marker{display:none}.service-num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--mono);font-size:12px;font-weight:600;color:var(--text-dim)}.service-item[open] .service-num{background:var(--gradient-brand);border-color:transparent;color:#fff}.service-name{font-family:var(--mono);font-size:18px;font-size:clamp(18px,2.5vw,28px);font-weight:700;letter-spacing:-.02em;color:var(--text)}.service-icon{width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:50%;font-size:14px;color:var(--text-dim);flex-shrink:0}.service-item[open] .service-icon{background:var(--purple-light);border-color:var(--purple);transform:rotate(45deg)}.service-content{padding-bottom:var(--space-5);padding-left:calc(40px + var(--space-3))}@media(min-width:600px){.service-content{padding-left:calc(56px + var(--space-4))}}.service-desc{font-size:16px;color:var(--text-mid);line-height:1.8;margin:0 0 var(--space-3);max-width:52ch}
