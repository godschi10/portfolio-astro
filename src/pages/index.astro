---
const title = "Gwill Chijioke — Web Design, Development & SEO";
const description = "I'm Gwill. Design, development and search. One person thinking about the whole website.";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const fontFaces = [400, 700, 800].map(weight =>
  `@font-face{font-family:JetBrains Mono;font-style:normal;font-weight:${weight};font-display:swap;src:url("${base}fonts/jetbrains-mono-latin-${weight}-normal.woff2") format("woff2")}`
).join('\n');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="color-scheme" content="light">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="deployment" content="GitHub Pages staging — not production">
<style is:inline set:html={fontFaces}></style>
<style is:global>
@font-face{font-family:"Mono fallback";src:local("DejaVu Sans Mono");size-adjust:99.6%}
:root{color-scheme:light;--canvas:#f7f6f3;--ink:#0d0d0d;--purple:#7c3aed;--green:#00c96e;--border:#e4e2dc;--muted:#55534f;--mono:"JetBrains Mono","Mono fallback",monospace}
*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.8}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit}a{color:inherit;text-decoration:none}button,a{touch-action:manipulation}button{cursor:pointer}a:focus-visible,button:focus-visible,[tabindex="-1"]:focus-visible{outline:3px solid var(--purple);outline-offset:4px}::selection{background:var(--purple);color:white}[hidden]{display:none!important}.wrap{width:calc(100% - 32px);max-width:1312px;margin-inline:auto}.skip{position:fixed;top:8px;left:16px;transform:translateY(-160%);background:white;z-index:1000;padding:12px 16px;min-height:48px}.skip:focus{transform:none}
.site-header{position:sticky;top:0;z-index:20;background:var(--canvas);border-bottom:1px solid var(--border)}.header-inner{min-height:64px;display:flex;align-items:center;gap:8px}.brand{display:flex;align-items:center;min-height:48px;margin-right:auto;flex-shrink:0}.wordmark{position:relative;display:inline-flex;align-items:baseline;font:700 clamp(20px,2.8vw,24px)/1 var(--mono);letter-spacing:-.04em;white-space:nowrap;font-feature-settings:"kern" 1,"liga" 1,"calt" 1}.wordmark .dot{font-weight:800;color:var(--purple);margin-left:1px}.wordmark::after{content:"";position:absolute;bottom:-6px;left:0;right:0;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--purple),var(--green));opacity:.7}.desktop-nav{display:none}.button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:56px;padding:12px 24px;border:1px solid var(--ink);border-radius:4px;font:700 16px/1.5 var(--mono);background:var(--ink);color:#fff;transition:background .18s,color .18s,transform .18s}.button .arrow{transition:transform .18s}.button:hover{background:var(--purple);border-color:var(--purple)}.button:hover .arrow{transform:translateX(3px)}.button:active{transform:translateY(1px)}.button.secondary{background:transparent;color:var(--ink)}.button.secondary:hover{background:var(--ink);color:white}.header-hire{min-height:48px;padding:8px 12px;gap:8px;white-space:nowrap}.header-hire .arrow{display:none}.menu-toggle,.menu-close{width:48px;height:48px;display:grid;place-items:center;background:transparent;border:1px solid var(--ink);border-radius:4px;flex-shrink:0}.menu-toggle svg{width:24px;height:24px}.menu-toggle:hover{color:var(--purple);border-color:var(--purple)}
.hero{position:relative;isolation:isolate;padding-top:40px;padding-bottom:40px;scroll-margin-top:96px}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}.intro{margin:0;font:400 16px/1.7 var(--mono);color:var(--muted)}.intro strong{color:var(--ink);font-weight:700}.intro .roles{display:block}.intro::before{content:"";display:block;width:40px;height:3px;background:var(--purple);margin-bottom:16px}h1{margin:0;font-family:var(--mono);font-weight:800;font-size:clamp(36px,8vw,96px);line-height:1.08;letter-spacing:-.04em;font-feature-settings:"kern" 1,"liga" 1,"calt" 1}h1 .line{display:block}.rank{color:var(--purple);position:relative}.rank-text{background:linear-gradient(110deg,#7c3aed 10%,#087b48 100%);background-clip:text;-webkit-background-clip:text;color:transparent}.cursor{display:inline-block;width:.09em;height:.72em;margin-left:.1em;background:var(--purple);vertical-align:-.02em;animation:blink 1.4s step-end infinite}.hero-actions{display:flex;flex-direction:column;gap:12px;align-items:stretch;align-self:start}.hero-actions .button{width:100%}.hero-note{margin:0;color:var(--muted);font-size:clamp(16px,1.3vw,18px);line-height:1.8;max-width:47ch}.hero-bottom{border-top:1px solid var(--border);margin-top:40px;padding-top:16px;display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;font:400 16px/1.6 var(--mono);color:var(--muted)}
/* Proposal: a source-code folio, not a live shell or invented output. */
.folio{position:relative;margin:0;min-width:0;padding:0 0 12px 0}.folio::before{content:"";position:absolute;inset:12px 0 0 12px;background:#e8e4ef;border:1px solid #cfc8dc;border-radius:6px;z-index:-1}.code-panel{border-radius:6px;border:1px solid #37323e;background:#17141c;color:#f7f6f3;box-shadow:0 16px 32px #25153b12;overflow:hidden}.code-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 20px;background:#232029;border-bottom:1px solid #443e4b;font:400 16px/1.5 var(--mono);color:#d1c9dc}.code-bar .code-icon{color:#b99be9;font-weight:700}.code-body{padding:24px 20px 20px;font:400 16px/1.7 var(--mono)}.comment{color:#d6ccdf;margin:0;overflow-wrap:anywhere}.syntax{color:#c1a0fa}.comment-content{display:block;padding-left:16px;margin-block:8px}.code-rule{height:1px;background:#443e4b;margin:24px 0 20px}.intent{display:grid;gap:12px;margin:0}.intent div{display:grid;grid-template-columns:32px 1fr;gap:12px}.intent dt{font-weight:700;color:#93deb5}.intent dd{margin:0;color:#f7f6f3}.intent .note{display:block;color:#c2bacb}.code-caption{padding:14px 20px;border-top:1px solid #443e4b;margin:0;font:400 16px/1.5 var(--mono);color:#c2bacb;display:flex;justify-content:space-between;gap:8px}.code-caption .signature{color:#93deb5}
.menu-overlay{position:fixed;inset:0;z-index:100;background:#17141c;color:#f7f6f3;overflow:auto;padding:16px;min-height:100dvh}.overlay-head{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:720px;margin:auto;font:700 20px/1.4 var(--mono)}.menu-close{border-color:#8c8298;color:white;font-size:32px}.overlay-nav{max-width:720px;margin:32px auto;display:flex;flex-direction:column}.overlay-nav a{min-height:64px;border-bottom:1px solid #443e4b;display:flex;align-items:center;justify-content:space-between;padding:8px 0;font:700 clamp(24px,4vw,40px)/1.4 var(--mono)}.overlay-nav a:hover{color:#c1a0fa}.overlay-hire{max-width:720px;margin:24px auto 0;display:flex;background:#f7f6f3;color:#0d0d0d;border-color:#f7f6f3}.menu-overlay :focus-visible{outline-color:#c1a0fa}.overlay-caption{max-width:720px;margin:16px auto;font-size:16px;color:#c2bacb}.route-notice{position:fixed;inset:auto 16px 16px;z-index:200;margin:auto;max-width:640px;background:white;border:2px solid var(--purple);border-radius:6px;box-shadow:0 12px 40px #17141c26;padding:20px;color:var(--ink)}.route-notice h2{font:700 20px/1.4 var(--mono);margin:0 0 8px}.route-notice p{margin:0 0 16px}.route-notice button{min-height:48px;min-width:96px}.no-js-nav{padding:16px;display:flex;flex-wrap:wrap;gap:8px}.no-js-nav a{padding:12px;min-height:48px;text-decoration:underline}
@keyframes blink{50%{opacity:0}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(min-width:768px){.wrap{width:calc(100% - 64px)}.header-inner{gap:16px}.header-hire .arrow{display:inline}.hero{padding-top:64px;padding-bottom:48px}.hero-grid{gap:32px}.intro .roles{display:inline}.intro .roles::before{content:" / ";color:#767069}.hero-actions{flex-direction:row;gap:16px}.hero-actions .button{width:auto;min-width:192px}.folio{max-width:640px;width:100%}.code-body{padding:28px}.intent{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.intent div{display:block}.intent dt{margin-bottom:8px}.code-bar,.code-caption{padding-inline:28px}.hero-bottom{margin-top:48px}}
@media(min-width:1024px){.wrap{width:calc(100% - 96px)}.desktop-nav{display:flex;align-items:center;gap:24px;margin-right:8px}.desktop-nav a{position:relative;display:flex;align-items:center;min-height:48px;font:600 14px/1.5 var(--mono);letter-spacing:.02em}.desktop-nav a::after{content:"";position:absolute;bottom:7px;left:0;width:0;height:2px;background:var(--purple);transition:width .18s}.desktop-nav a:hover::after,.desktop-nav a:focus-visible::after{width:50%}.menu-toggle{display:none}.header-hire{font-size:13px;padding-inline:20px}.hero{padding-top:72px;padding-bottom:40px}.hero-grid{grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);column-gap:48px;row-gap:24px}.intro{grid-column:1/-1}h1{grid-column:1;grid-row:2}.folio{grid-column:2;grid-row:2/5;align-self:center;margin-top:16px;margin-left:32px;padding-bottom:16px}.hero-actions{grid-column:1;grid-row:3;margin-top:8px}.hero-note{grid-column:1;grid-row:4}.intent{grid-template-columns:1fr;gap:20px}.intent div{display:grid}.intent dt{margin:0}.code-body{padding:28px 24px}.code-bar,.code-caption{padding-inline:24px}.code-caption{flex-wrap:wrap}.hero-bottom{margin-top:64px}}
@media(max-width:767px){.code-body{padding:16px 20px}.comment-content{display:inline;padding:0;margin:0}.code-rule{margin:16px 0}.intent{gap:8px}.intent .note{display:inline;margin-left:8px}.code-caption{padding:10px 20px}.code-bar{padding:10px 20px}.hero-actions{align-self:start}.hero-grid{row-gap:24px}}
@media(max-width:359px){.header-inner{display:grid;grid-template-columns:1fr 48px;padding-block:8px}.brand{grid-column:1;grid-row:1}.menu-toggle{grid-column:2;grid-row:1}.header-hire{grid-column:1/-1;grid-row:2}.hero{padding-top:32px}.hero .rank{max-width:100%}.cursor{display:none}}
@media(forced-colors:active){.rank-text{background:none;color:CanvasText}.cursor{background:CanvasText}.wordmark::after{background:LinkText}}
/* Existing below-hero scope and contact, not a new full-site section. */
#work{padding-block:64px;border-top:1px solid var(--border);scroll-margin-top:144px}
#work p{font-size:16px;color:var(--muted)}
footer{padding-block:40px;border-top:1px solid var(--border);text-align:center;font-size:16px;color:var(--muted)}
footer p{margin:0 0 8px}footer a{display:inline-flex;align-items:center;min-height:48px;color:var(--purple)}footer a:hover{text-decoration:underline}
#portfolio-scope{scroll-margin-top:144px}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header" id="top"><div class="wrap header-inner">
<a class="brand" href={base} aria-label="gwillchijioke. — home" aria-current="page"><span class="wordmark"><span>gwillchijioke</span><span class="dot">.</span></span></a>
<nav class="desktop-nav" aria-label="Primary"><a href="#portfolio-scope" data-scope="About" aria-haspopup="dialog">About</a><a href="#work">Work</a><a href="#portfolio-scope" data-scope="Services" aria-haspopup="dialog">Services</a><a href="https://tech.gwillchijioke.com/" target="_blank" rel="noopener noreferrer" aria-label="Tech Blog (opens in a new tab)">Tech Blog ↗</a></nav>
<a class="button header-hire" href="mailto:hi@gwillchijioke.com">Hire Me <span class="arrow" aria-hidden="true">→</span></a>
<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="compact-menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button>
</div></header>
<noscript><nav class="no-js-nav" aria-label="Navigation without JavaScript"><a href="#work">Work</a><a href="#portfolio-scope">About / Services scope</a><a href="https://tech.gwillchijioke.com/" target="_blank" rel="noopener noreferrer">Tech Blog ↗</a><a href="mailto:hi@gwillchijioke.com">Contact Gwill</a></nav><style is:inline>.menu-toggle{display:none}</style></noscript>
<main id="main" tabindex="-1"><section class="hero" aria-labelledby="hero-title"><div class="wrap">
<div class="hero-grid">
<p class="intro"><strong>I'm Gwill.</strong> <span class="roles">Web dev · Designer · SEO</span></p>
<h1 id="hero-title"><span class="line">I design.</span> <span class="line">I build.</span> <span class="line rank"><span class="rank-text">I make it rank.</span><span class="cursor" aria-hidden="true"></span></span></h1>
<figure class="folio" aria-label="Illustrated source comment: turning ideas into fast, ranked websites. Design for people, build for speed, structure for search. Not a running terminal.">
<div class="code-panel"><div class="code-bar"><span><span class="code-icon" aria-hidden="true">&lt;/&gt;</span> approach.html</span><span aria-hidden="true">—</span></div>
<div class="code-body"><p class="comment"><span class="syntax">&lt;!--</span><span class="comment-content">turning ideas into fast, ranked websites</span><span class="syntax">--&gt;</span></p><div class="code-rule" aria-hidden="true"></div><dl class="intent"><div><dt>01</dt><dd>Design<span class="note">for people.</span></dd></div><div><dt>02</dt><dd>Build<span class="note">for speed.</span></dd></div><div><dt>03</dt><dd>Structure<span class="note">for search.</span></dd></div></dl></div>
<figcaption class="code-caption"><span>Intent, not output.</span><span class="signature">// Gwill</span></figcaption></div></figure>
<div class="hero-actions"><a class="button" href="mailto:hi@gwillchijioke.com">Hire Me <span class="arrow" aria-hidden="true">→</span></a><a class="button secondary" href="#work">View Work <span aria-hidden="true">↓</span></a></div>
<p class="hero-note">Design, development and search.<br>One person thinking about the whole website.</p>
</div>
<div class="hero-bottom"><span>gwillchijioke / personal portfolio</span><span>Design ↔ Code ↔ Search</span></div>
</div></section>
    <section id="work" class="wrap" tabindex="-1">
      <p>Selected work &mdash; next section to be designed.</p>
    </section>
</main>
<footer class="wrap">
<p>Portfolio staging — header and hero integrated; selected work is still pending.</p>
<p id="portfolio-scope" tabindex="-1">About and Services are not available in this staging build yet. Please email me to discuss your project.</p>
<a href="mailto:hi@gwillchijioke.com">hi@gwillchijioke.com</a>
</footer>
<div class="menu-overlay" id="compact-menu" role="dialog" aria-modal="true" aria-labelledby="menu-title" hidden><div class="overlay-head"><span id="menu-title">Explore / Gwill</span><button class="menu-close" aria-label="Close navigation" type="button">×</button></div><nav class="overlay-nav" aria-label="Compact primary"><a href="#portfolio-scope" data-scope="About" aria-haspopup="dialog">About <span aria-hidden="true">→</span></a><a href="#work">Work <span aria-hidden="true">→</span></a><a href="#portfolio-scope" data-scope="Services" aria-haspopup="dialog">Services <span aria-hidden="true">→</span></a><a href="https://tech.gwillchijioke.com/" target="_blank" rel="noopener noreferrer" aria-label="Tech Blog (opens in a new tab)">Tech Blog <span aria-hidden="true">↗</span></a><a href="mailto:hi@gwillchijioke.com">Contact <span aria-hidden="true">→</span></a></nav><a class="button overlay-hire" href="mailto:hi@gwillchijioke.com">Hire Me <span aria-hidden="true">→</span></a><p class="overlay-caption">Personal portfolio / navigation</p></div>
<div class="route-notice" role="dialog" aria-modal="true" aria-labelledby="route-title" aria-describedby="route-copy" hidden><h2 id="route-title">Section not available yet</h2><p id="route-copy"></p><button class="button" type="button">Close</button></div>
<script is:inline>
(() => {
 const toggle=document.querySelector('.menu-toggle'), menu=document.querySelector('.menu-overlay'), notice=document.querySelector('.route-notice');
 const page=[...document.body.children].filter(el=>!['SCRIPT','STYLE','NOSCRIPT'].includes(el.tagName)&&el!==menu&&el!==notice);
 let active=null,returnTo=null;
 function controls(el){return [...el.querySelectorAll('a[href],button')].filter(x=>!x.disabled&&!x.hidden)}
 function open(el,trigger){if(active)close(false);returnTo=trigger;active=el;el.hidden=false;page.forEach(x=>x.inert=true);document.body.style.overflow='hidden';toggle.setAttribute('aria-expanded',String(el===menu));controls(el)[0]?.focus()}
 function close(restore=true){if(!active)return;active.hidden=true;active=null;page.forEach(x=>x.inert=false);document.body.style.overflow='';toggle.setAttribute('aria-expanded','false');if(restore)returnTo?.focus()}
 toggle.addEventListener('click',()=>open(menu,toggle));toggle.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open(menu,toggle)}});menu.querySelector('button').addEventListener('click',()=>close());notice.querySelector('button').addEventListener('click',()=>close());
 document.querySelectorAll('[data-scope]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const fromMenu=menu.contains(a);document.querySelector('#route-copy').textContent=a.dataset.scope+' is not available in this staging build yet. Please email hi@gwillchijioke.com to discuss your project.';open(notice,fromMenu?toggle:a)}));
 menu.querySelectorAll('a:not([data-scope])').forEach(a=>a.addEventListener('click',()=>{close();if(a.getAttribute('href')==='#work')document.querySelector('#work').focus()}));
 document.addEventListener('keydown',e=>{if(!active)return;if(e.key==='Escape'){e.preventDefault();close();return}if(e.key==='Tab'){const nodes=controls(active),first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
 document.addEventListener('focusin',e=>{if(active&&!active.contains(e.target))controls(active)[0]?.focus()});
 window.addEventListener('resize',()=>{if(innerWidth>=1024&&active===menu)close()});
})();
</script>
</body></html>
