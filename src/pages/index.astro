:root{--font-body:"NairaSign",-apple-system,"Segoe UI",Roboto,sans-serif;--text:#0d0d0d;--text-mid:#3a3a3a;--text-dim:#6e6e6e;--bg:#f7f6f3;--surface:#fff;--border-dark:#d4d0c8;--purple-light:rgba(124,58,237,.08);--radius-md:8px;--radius-lg:12px;--radius-full:9999px;--shadow-md:0 4px 12px rgba(0,0,0,.08),0 8px 24px rgba(0,0,0,.06);--shadow-lg:0 8px 32px rgba(0,0,0,.1),0 16px 48px rgba(0,0,0,.08);--t-slow:400ms ease;--space-1:4px;--space-8:96px}
