@media(min-width:768px){.hero{padding-top:64px;padding-bottom:110px}.hero-grid{gap:32px}.intro .roles{display:inline}.intro .roles::before{content:" / ";color:#767069}.hero-actions{flex-direction:row;gap:16px}.hero-actions .button{width:auto;min-width:192px}.folio{max-width:640px;width:100%}.code-body{padding:28px}.intent{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.intent div{display:block}.intent dt{margin-bottom:8px}.code-bar,.code-caption{padding-inline:28px}}
