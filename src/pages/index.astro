---
import Layout from '../layouts/Layout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = "Gwill Chijioke — Web Design, Development & SEO";
const description = "I'm Gwill. Design, development and search. One person thinking about the whole website.";
---
<Layout title={title} description={description}>
<section class="hero" aria-labelledby="hero-title"><div class="wrap">
<div class="hero-grid">
<p class="intro"><strong>I'm Gwill.</strong> <span class="roles">Web dev · Designer · SEO</span></p>
<h1 id="hero-title"><span class="line">I design.</span> <span class="line">I build.</span> <span class="line rank"><span class="rank-text">I make it rank.</span><span class="cursor" aria-hidden="true"></span></span></h1>
<figure class="folio" aria-label="Illustrated source comment: turning ideas into fast, ranked websites. Design for people, build for speed, structure for search. Not a running terminal.">
<div class="code-panel"><div class="code-bar"><span><span class="code-icon" aria-hidden="true">&lt;/&gt;</span> approach.html</span><span aria-hidden="true">—</span></div>
<div class="code-body"><p class="comment"><span class="syntax">&lt;!--</span><span class="comment-content">turning ideas into fast, ranked websites</span><span class="syntax">--&gt;</span></p><div class="code-rule" aria-hidden="true"></div><dl class="intent"> <div><dt>01</dt><dd>Design<span class="note">for people.</span></dd></div> <div><dt>02</dt><dd>Build<span class="note">for speed.</span></dd></div> <div><dt>03</dt><dd>Structure<span class="note">for search.</span></dd></div></dl></div>
<figcaption class="code-caption"><span>Intent, not output.</span><span class="signature">// Gwill</span></figcaption></div></figure>
<div class="hero-actions"><a class="button" href={`${base}contact/`}>Hire Me <span class="arrow" aria-hidden="true">→</span></a><a class="button secondary" href={`${base}work/`}>View Work <span aria-hidden="true">→</span></a></div>
<p class="hero-note">Design, development and search.<br>One person thinking about the whole website.</p>
</div>
<div class="hero-bottom"><span>gwillchijioke / personal portfolio</span><span>Design ↔ Code ↔ Search</span></div>
</div></section>
<div class="marquee" role="presentation"><div class="marquee-track"><span>WordPress · SEO · Web Design · Cloudflare · Performance · Branding ·&nbsp;</span><span aria-hidden="true">WordPress · SEO · Web Design · Cloudflare · Performance · Branding ·&nbsp;</span></div></div>
<section id="selected-work" class="wrap home-section" aria-labelledby="selected-work-title">
<p class="eyebrow">Selected Work</p>
<h2 id="selected-work-title">Work that performs.</h2>
<div class="work-grid">
<article class="work-card work-card--hero"><h3>Project 1 — unnamed placeholder</h3><p class="work-tags">WordPress · SEO · Design</p><p class="work-hold">Case study lands with real project content.</p><a class="text-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">→</span></a></article>
<article class="work-card"><h3>Project 2 — unnamed placeholder</h3><p class="work-tags">Design · Build</p><p class="work-hold">Case study lands with real project content.</p><a class="text-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">→</span></a></article>
<article class="work-card"><h3>Project 3 — unnamed placeholder</h3><p class="work-tags">SEO · Performance</p><p class="work-hold">Case study lands with real project content.</p><a class="text-link" href={`${base}work/`}>View on Work page <span aria-hidden="true">→</span></a></article>
</div>
</section>
<section id="home-services" class="wrap home-section" aria-labelledby="home-services-title">
<p class="eyebrow">Services</p>
<h2 id="home-services-title">What I Do</h2>
<div class="home-service-list">
<details><summary><span class="svc-num">01</span> Web Development <span class="svc-plus" aria-hidden="true">+</span></summary><p>Custom WordPress sites, with a focus on speed, SEO and conversion.</p></details>
<details><summary><span class="svc-num">02</span> Web Design <span class="svc-plus" aria-hidden="true">+</span></summary><p>Clean, intentional, mobile-first web design.</p></details>
<details><summary><span class="svc-num">03</span> SEO <span class="svc-plus" aria-hidden="true">+</span></summary><p>Technical and content SEO.</p></details>
<details><summary><span class="svc-num">04</span> Tech Consulting <span class="svc-plus" aria-hidden="true">+</span></summary><p>Cloudflare, performance audits and stack decisions.</p></details>
</div>
<a class="button secondary" href={`${base}services/`}>All Services <span aria-hidden="true">→</span></a>
</section>
<section id="home-about" class="wrap home-section" aria-labelledby="home-about-title">
<p class="eyebrow">About</p>
<h2 id="home-about-title">I'm Gwill — a web developer who obsesses over performance, design and search rankings.</h2>
<p>This staging preview is the design coming together. The full story lands with production.</p>
<a class="button secondary" href={`${base}about/`}>More About Me <span aria-hidden="true">→</span></a>
</section>
<section id="home-blog" class="wrap home-section" aria-labelledby="home-blog-title">
<p class="eyebrow">Tech Blog</p>
<h2 id="home-blog-title">Latest From The Tech Blog</h2>
<p>Posts publish with production. Meanwhile the live blog is one tap away.</p>
<a class="button secondary" href="https://tech.gwillchijioke.com/" target="_blank" rel="noopener noreferrer">Visit Tech Blog <span aria-hidden="true">↗</span></a>
</section>
</Layout>
<style is:global>
.hero{position:relative;isolation:isolate;padding-top:40px;padding-bottom:40px;scroll-margin-top:96px}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}.intro{margin:0;font:400 16px/1.7 var(--mono);color:var(--muted)}.intro strong{color:var(--ink);font-weight:700}.intro .roles{display:block}.intro::before{content:"";display:block;width:40px;height:3px;background:var(--purple);margin-bottom:16px}h1{margin:0;font-family:var(--mono);font-weight:800;font-size:clamp(36px,8vw,96px);line-height:1.08;letter-spacing:-.04em;font-feature-settings:"kern" 1,"liga" 1,"calt" 1}h1 .line{display:block}.rank{color:var(--purple);position:relative}.rank-text{background:linear-gradient(110deg,#7c3aed 10%,#087b48 100%);background-clip:text;-webkit-background-clip:text;color:transparent}.cursor{display:inline-block;width:.09em;height:.72em;margin-left:.1em;background:var(--purple);vertical-align:-.02em;animation:blink 1.4s step-end infinite}.hero-actions{display:flex;flex-direction:column;gap:12px;align-items:stretch;align-self:start}.hero-actions .button{width:100%}.hero-note{margin:0;color:var(--muted);font-size:clamp(16px,1.3vw,18px);line-height:1.8;max-width:47ch}.hero-bottom{border-top:1px solid var(--border);margin-top:40px;padding-top:16px;display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;font:400 16px/1.6 var(--mono);color:var(--muted)}
.folio{position:relative;margin:0;min-width:0;padding:0 0 12px 0}.folio::before{content:"";position:absolute;inset:12px 0 0 12px;background:#e8e4ef;border:1px solid #cfc8dc;border-radius:6px;z-index:-1}.code-panel{border-radius:6px;border:1px solid #37323e;background:#17141c;color:#f7f6f3;box-shadow:0 16px 32px #25153b12;overflow:hidden}.code-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 20px;background:#232029;border-bottom:1px solid #443e4b;font:400 16px/1.5 var(--mono);color:#d1c9dc}.code-bar .code-icon{color:#b99be9;font-weight:700}.code-body{padding:24px 20px 20px;font:400 16px/1.7 var(--mono)}.comment{color:#d6ccdf;margin:0;overflow-wrap:anywhere}.syntax{color:#c1a0fa}.comment-content{display:block;padding-left:16px;margin-block:8px}.code-rule{height:1px;background:#443e4b;margin:24px 0 20px}.intent{display:grid;gap:12px;margin:0}.intent div{display:grid;grid-template-columns:32px 1fr;gap:12px}.intent dt{font-weight:700;color:#93deb5}.intent dd{margin:0;color:#f7f6f3}.intent .note{display:block;color:#c2bacb}.code-caption{padding:14px 20px;border-top:1px solid #443e4b;margin:0;font:400 16px/1.5 var(--mono);color:#c2bacb;display:flex;justify-content:space-between;gap:8px}.code-caption .signature{color:#93deb5}
@media(min-width:768px){.hero{padding-top:64px;padding-bottom:48px}.hero-grid{gap:32px}.intro .roles{display:inline}.intro .roles::before{content:" / ";color:#767069}.hero-actions{flex-direction:row;gap:16px}.hero-actions .button{width:auto;min-width:192px}.folio{max-width:640px;width:100%}.code-body{padding:28px}.intent{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.intent div{display:block}.intent dt{margin-bottom:8px}.code-bar,.code-caption{padding-inline:28px}.hero-bottom{margin-top:48px}}
@media(min-width:1024px){.hero{padding-top:72px;padding-bottom:40px}.hero-grid{grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);column-gap:48px;row-gap:24px}.intro{grid-column:1/-1}h1{grid-column:1;grid-row:2}.folio{grid-column:2;grid-row:2/5;align-self:center;margin-top:16px;margin-left:32px;padding-bottom:16px}.hero-actions{grid-column:1;grid-row:3;margin-top:8px}.hero-note{grid-column:1;grid-row:4}.intent{grid-template-columns:1fr;gap:20px}.intent div{display:grid}.intent dt{margin:0}.code-body{padding:28px 24px}.code-bar,.code-caption{padding-inline:24px}.code-caption{flex-wrap:wrap}.hero-bottom{margin-top:64px}}
@media(max-width:767px){.code-body{padding:16px 20px}.comment-content{display:inline;padding:0;margin:0}.code-rule{margin:16px 0}.intent{gap:8px}.intent .note{display:inline;margin-left:8px}.code-caption{padding:10px 20px}.code-bar{padding:10px 20px}.hero-actions{align-self:start}.hero-grid{row-gap:24px}}
@media(max-width:359px){.hero{padding-top:32px}.hero .rank{max-width:100%}.cursor{display:none}}
.marquee{background:#0d0d0d;color:#e2e8f0;overflow:hidden;padding-block:14px;border-block:1px solid #0d0d0d}.marquee-track{display:flex;width:max-content;animation:marquee 30s linear infinite;font:700 14px/1.5 var(--mono);letter-spacing:.06em;white-space:nowrap}.marquee:hover .marquee-track{animation-play-state:paused}@keyframes marquee{to{transform:translateX(-50%)}}
.home-section{padding-block:56px;scroll-margin-top:96px}.home-section + .home-section{border-top:1px solid var(--border)}.eyebrow{margin:0 0 8px;font:700 13px/1.5 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--purple)}.home-section h2{margin:0 0 24px;font-family:var(--mono);font-weight:800;font-size:clamp(24px,4vw,44px);line-height:1.15;letter-spacing:-.03em;max-width:22ch}.home-section > p{color:var(--muted);font-size:16px;max-width:60ch}.home-section .button{margin-top:24px}
.work-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.work-card{border:1px solid var(--border);border-radius:6px;padding:24px 20px;background:#fff}.work-card h3{margin:0 0 8px;font:700 18px/1.4 var(--mono)}.work-tags{margin:0 0 8px;font:400 14px/1.5 var(--mono);color:var(--purple)}.work-hold{margin:0 0 12px;color:var(--muted);font-size:15px}
.home-service-list{display:grid;gap:0;border-top:1px solid var(--border)}.home-service-list details{border-bottom:1px solid var(--border)}.home-service-list summary{display:flex;align-items:center;gap:12px;min-height:56px;list-style:none;cursor:pointer;font:700 17px/1.4 var(--mono)}.home-service-list summary::-webkit-details-marker{display:none}.home-service-list summary .svc-num{color:var(--purple);font-size:14px}.home-service-list summary .svc-plus{margin-left:auto;color:var(--muted)}.home-service-list details[open] summary .svc-plus{transform:rotate(45deg)}.home-service-list details p{margin:0 0 16px;color:var(--muted);font-size:16px;max-width:60ch}
.text-link{display:inline-flex;align-items:center;min-height:48px;text-decoration:underline;text-underline-offset:4px;color:var(--purple)}
@media(min-width:768px){.marquee-track{animation-duration:22s;font-size:15px}.home-section{padding-block:72px}.work-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.work-card--hero{grid-column:1/-1}}
@media(min-width:1024px){.home-section{padding-block:88px}.work-grid{gap:24px}.work-card{padding:32px}}
@media(prefers-reduced-motion:reduce){.marquee-track{animation:none}.cursor{animation:none}}
</style>
