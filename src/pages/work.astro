---
import Layout from '../layouts/Layout.astro';
import { studies } from '../data/work';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
// Theme port (page-work.php + card-work.php): asymmetric grid, browser-frame
// cards, theme CTA. Cards link to the three real case studies; screenshot
// panels stay honest placeholders until King supplies exports.
const frameUrl = (slug: string, liveUrl?: string) =>
  liveUrl ? liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : `gwillchijioke.com/work/${slug}`;
---
<Layout title="Selected Work — Gwill Chijioke" description="Selected Work: this portfolio site, AndroidScroll, and a finance blog on the way — each with a case study.">
<article class="work-page">
<div class="work-hero"><div class="wrap">
<p class="work-crumb" aria-hidden="true"><span>work</span></p>
<p class="work-label">Selected Work</p>
<h1 id="work-title">Projects I’ve built<br>and results I’ve earned.</h1>
</div></div>
<section class="work-archive-section" aria-labelledby="work-archive-heading"><div class="wrap">
<h2 id="work-archive-heading" class="sr-only">Portfolio</h2>
<div class="work-archive-grid">
{studies.map((study, i) => (
<article class="work-card" aria-labelledby={`project-${study.slug}-title`}>
<div class="work-card__frame">
<div class="work-card__frame-bar" aria-hidden="true">
<span class="work-card__frame-dot work-card__frame-dot--purple"></span>
<span class="work-card__frame-dot work-card__frame-dot--green"></span>
<span class="work-card__frame-dot work-card__frame-dot--dim"></span>
<span class="work-card__frame-url">{frameUrl(study.slug, study.liveUrl)}</span>
<span class="work-card__index" aria-hidden="true">0{i + 1}</span>
</div>
<div class="work-card__image-wrap">
<div class="work-card__placeholder" aria-hidden="true"></div>
</div>
</div>
<div class="work-card__body">
<div class="work-card__tags">{study.tags.map(tag => (<span class="tag">{tag}</span>))}</div>
<h3 class="work-card__name" id={`project-${study.slug}-title`}>{study.name}</h3>
<p class="work-card__desc">{study.desc}</p>
{study.status === 'soon'
? (<p class="case-study-status">Coming soon — full case study ships at launch.</p>)
: (<p class="case-study-status case-study-status--live">Case study live.</p>)}
<a class="work-card__cta section-link" href={`${base}work/${study.slug}/`}>Read the case study <span aria-hidden="true">&#x2192;</span></a>
</div>
</article>
))}
</div>
</div></section>
<section class="work-cta-section" aria-label="Start a project"><div class="wrap">
<div class="work-cta-inner">
<h2 class="work-cta-headline">Want your project here?</h2>
<p class="work-cta-sub">I take on a small number of projects at a time. If you have something worth building, let&rsquo;s talk.</p>
<div class="work-cta-actions">
<a class="button" href={`${base}contact/`}>Hire Me <span class="arrow" aria-hidden="true">→</span></a>
<a class="button secondary" href={`${base}services/`}>View Services <span aria-hidden="true">→</span></a>
</div>
</div>
</div></section>
</article>
</Layout>
<style is:global>
.work-page{--bg:var(--canvas);--surface:#fff;--text:var(--ink);--text-mid:#3a3a3a;--text-dim:var(--muted);--font-mono:var(--mono);--border-dark:#d4d0c8;--purple-light:rgba(124,58,237,.08);--radius-lg:12px;--radius-full:9999px;--shadow-lg:0 8px 32px rgba(0,0,0,.10),0 16px 48px rgba(0,0,0,.08);--t-slow:400ms ease}
.work-hero{padding-block:48px;padding-block:clamp(48px,8vw,96px) clamp(32px,4vw,48px);border-bottom:1px solid var(--border);background:var(--bg)}
.work-crumb{font-family:var(--font-mono);font-size:12px;font-weight:600;color:var(--text-dim);margin:0 0 var(--space-4);display:flex;align-items:center;gap:8px}
.work-crumb::before{content:'~/';color:var(--purple)}
.work-crumb span{color:var(--purple)}
.work-label{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--purple);margin:0 0 var(--space-3)}
.work-label::before{content:'//';color:var(--text-dim);opacity:.5;font-size:.9em}
.work-hero h1{font-family:var(--font-mono);font-size:clamp(32px,6vw,72px);font-weight:800;letter-spacing:-.04em;line-height:1.05;color:var(--text);margin:0;-webkit-font-smoothing:antialiased}
.work-archive-section{background:var(--bg);padding-block:48px;padding-block:clamp(48px,6vw,96px)}
.work-archive-grid{display:grid;grid-template-columns:1fr;gap:var(--space-4)}
.work-card{position:relative;overflow:hidden;border-radius:var(--radius-lg);border:1px solid var(--border);background:var(--surface);transition:box-shadow var(--t-base)}
.work-card__frame{background:var(--surface);border-bottom:1px solid var(--border);overflow:hidden}
.work-card__frame-bar{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg);border-bottom:1px solid var(--border)}
.work-card__frame-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.work-card__frame-dot--purple{background:var(--purple);opacity:.85}
.work-card__frame-dot--green{background:var(--green);opacity:.85}
.work-card__frame-dot--dim{background:var(--border-dark)}
.work-card__frame-url{flex:1;font-family:var(--font-mono);font-size:10px;color:var(--text-dim);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.02em}
.work-card__index{display:inline-flex;align-items:center;flex-shrink:0;font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--purple);background:var(--surface);border:1px solid rgba(124,58,237,.35);border-radius:var(--radius-full);padding:3px 9px;margin-left:auto}
.work-card__image-wrap{min-height:180px;aspect-ratio:16/9;overflow:hidden;background:var(--border);border-radius:0}
.work-card__placeholder{width:100%;height:100%;background:linear-gradient(135deg,var(--border) 0%,var(--bg) 100%);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:12px;color:var(--text-dim);letter-spacing:.1em;border-bottom-left-radius:0;border-bottom-right-radius:0}
.work-card__placeholder::after{content:'Screenshot coming soon'}
.work-card__body{padding:var(--space-4) var(--space-5) var(--space-5)}
.work-card__tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.tag{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:3px 10px;border-radius:4px;background:var(--purple-light);color:var(--purple);border:1px solid rgba(124,58,237,.15)}
.work-card__name{font-family:var(--font-mono);font-size:clamp(16px,1.8vw,20px);font-weight:700;letter-spacing:-.02em;color:var(--text);margin:0 0 6px}
.work-card__desc{font-size:16px;color:var(--text-dim);line-height:1.6;margin:0}
.case-study-status{font-family:var(--font-mono);font-size:13px;color:var(--text-dim);border-top:1px solid var(--border);padding-top:16px;margin:16px 0 0}
.case-study-status--live{color:var(--purple);font-weight:700}
.work-card__cta{display:inline-flex;margin-top:12px}
.work-cta-section{padding-block:24px;padding-block:clamp(24px,3vw,48px);background:var(--surface);border-top:1px solid var(--border)}
.work-cta-inner{display:flex;flex-direction:column;gap:var(--space-4)}
.work-cta-headline{font-family:var(--font-mono);font-size:clamp(24px,3.5vw,40px);font-weight:700;letter-spacing:-.03em;color:var(--text);margin:0;-webkit-font-smoothing:antialiased}
.work-cta-sub{font-size:16px;color:var(--text-dim);max-width:52ch;line-height:1.7;margin:0}
.work-cta-actions{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-2)}
@media(min-width:768px){.work-archive-grid{grid-template-columns:1fr 1fr}.work-archive-grid .work-card:first-child{grid-column:1/-1}.work-archive-grid .work-card:first-child .work-card__image-wrap{aspect-ratio:21/9}}
@media(hover:hover) and (pointer:fine){.work-card:hover{border-color:transparent;box-shadow:var(--shadow-lg)}.work-card:hover .work-card__frame-url{color:var(--purple)}}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
