.international-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;margin-top:var(--space-6)}
.international-item{background:var(--surface);padding:var(--space-5) var(--space-4);display:flex;flex-direction:column;gap:var(--space-2)}
.international-name{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim);margin:0}
.international-price{font-family:var(--font-mono);font-size:clamp(14px,1.4vw,17px);font-weight:800;color:var(--text);letter-spacing:-.02em;margin:0;-webkit-font-smoothing:antialiased}
.international-price-alt{font-family:var(--font-mono);font-size:13px;color:var(--text-dim);letter-spacing:.02em;margin:0}
.services-cta-section{padding-block:64px;padding-block:clamp(64px,8vw,96px);background:var(--surface);border-top:1px solid var(--border)}
.services-cta-inner{display:flex;flex-direction:column;gap:var(--space-4)}
.services-cta-headline{font-family:var(--font-mono);font-size:clamp(24px,3.5vw,40px);font-weight:700;letter-spacing:-.03em;color:var(--text);margin:0;-webkit-font-smoothing:antialiased}
.services-cta-sub{font-size:16px;color:var(--text-dim);max-width:52ch;line-height:1.7;margin:0}
