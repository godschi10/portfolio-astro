@media(min-width:640px){.packages-grid--4{grid-template-columns:repeat(2,1fr)}.maintenance-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:768px){.international-grid{grid-template-columns:repeat(4,1fr)}.service-trigger{grid-template-columns:56px 1fr auto;gap:var(--space-4)}.service-content{padding-left:calc(56px + var(--space-4))}}
