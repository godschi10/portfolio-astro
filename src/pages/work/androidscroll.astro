---
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { studies, neighbors } from '../../data/work';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const study = studies[1];
const { prev, next } = neighbors(study.slug);
---
<Layout title="AndroidScroll Case Study — Gwill Chijioke" description="Case study: AndroidScroll, a live Android help publication — pillar shelves, honest counts, app-like search, and a published test method.">
<div class="case-page">
<CaseStudy study={study} prev={prev} next={next} base={base} />
</div>
</Layout>
<style is:global>
.case-page{--bg:var(--canvas);--surface:#fff;--text:var(--ink);--text-mid:#3a3a3a;--text-dim:var(--muted);--font-mono:var(--mono);--border-dark:#d4d0c8;--purple-light:rgba(124,58,237,.08);--radius-md:8px;--radius-lg:12px;--radius-full:9999px;--space-1:4px;--space-8:96px}
</style>
