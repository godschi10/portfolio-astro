---
// Case-study body — theme port (case-study.php §§1–8 + style.css §31):
// hero → 01 Problem → 02 Solution → 03 Result → Built-with → case-nav → CTA.
// Screenshots/stack sections render only when the study ships them; the nav
// thumb uses the theme's gradient fallback swatch (no study ships images yet).
// Astro has no hire-me route — CTA points at contact/ (brief orders it).
import type { WorkStudy } from '../data/work';
interface Props { study: WorkStudy; prev: WorkStudy; next: WorkStudy; base: string; }
const { study, prev, next, base } = Astro.props;
---
<div class="case-hero"><div class="wrap">
<p class="case-crumb"><a href={`${base}work/`}>work</a><span class="case-crumb-sep" aria-hidden="true">/</span><span>{study.slug}</span></p>
<p class="case-label">Case Study</p>
<h1 class="case-hero-title">{study.name}</h1>
<div class="case-hero-meta">
<div class="case-hero-tags">{study.tags.map(tag => (<span class="tag">{tag}</span>))}</div>
<div class="case-hero-details">
{study.role && (<span class="case-detail"><span class="case-detail-label">Role</span>{study.role}</span>)}
{study.year && (<span class="case-detail"><span class="case-detail-label">Year</span>{study.year}</span>)}
{study.liveUrl && (<a href={study.liveUrl} class="case-live-link" target="_blank" rel="noopener noreferrer">View Live Site <span aria-hidden="true">&#x2197;</span></a>)}
{study.status === 'soon' && (<span class="case-detail"><span class="case-detail-label">Status</span>Coming soon</span>)}
</div>
</div>
</div></div>
<section class="case-section case-section--problem" aria-labelledby="problem-heading"><div class="wrap">
<div class="case-section-header"><span class="case-section-num" aria-hidden="true">01</span><h2 id="problem-heading" class="case-section-title">The Problem</h2></div>
<div class="case-prose">{study.problem.map(p => (<p>{p}</p>))}</div>
</div></section>
<section class="case-section case-section--solution" aria-labelledby="solution-heading"><div class="wrap">
<div class="case-section-header"><span class="case-section-num" aria-hidden="true">02</span><h2 id="solution-heading" class="case-section-title">The Solution</h2></div>
<div class="case-prose">{study.solution.map(p => (<p>{p}</p>))}</div>
</div></section>
<section class="case-section case-section--result" aria-labelledby="result-heading"><div class="wrap">
<div class="case-section-header"><span class="case-section-num" aria-hidden="true">03</span><h2 id="result-heading" class="case-section-title">The Result</h2></div>
{study.results && (<div class="case-results-grid">{study.results.map(r => (
<div class="case-result"><span class="case-result-number">{r.number}<span>{r.suffix}</span></span><span class="case-result-label">{r.label}</span></div>
))}</div>)}
{study.resultNote && (<p class="case-result-note">{study.resultNote}</p>)}
</div></section>
{study.stack && (
<section class="case-stack-section" aria-label="Technology stack"><div class="wrap">
<p class="case-stack-label">Built with</p>
<div class="case-stack">{study.stack.map(tool => (<span class="case-stack-item">{tool}</span>))}</div>
</div></section>
)}
<nav class="case-nav" aria-label="Project navigation"><div class="wrap">
<p class="case-nav-eyebrow">Continue exploring</p>
<div class="case-nav-inner">
<a href={`${base}work/${prev.slug}/`} class="case-nav-link case-nav-link--prev">
<span class="case-nav-thumb" aria-hidden="true"><span class="case-nav-thumb-fallback"></span></span>
<span class="case-nav-link-text"><span class="case-nav-dir">Previous project</span><span class="case-nav-title">{prev.name}</span></span>
<span class="case-nav-arrow" aria-hidden="true">&#x2190;</span>
</a>
<a href={`${base}work/`} class="case-nav-all">All Projects<span class="case-nav-all-icon" aria-hidden="true">&#x2630;</span></a>
<a href={`${base}work/${next.slug}/`} class="case-nav-link case-nav-link--next">
<span class="case-nav-arrow" aria-hidden="true">&#x2192;</span>
<span class="case-nav-link-text"><span class="case-nav-dir">Next project</span><span class="case-nav-title">{next.name}</span></span>
<span class="case-nav-thumb" aria-hidden="true"><span class="case-nav-thumb-fallback"></span></span>
</a>
</div>
</div></nav>
<section class="case-cta-section" aria-label="Start a project"><div class="wrap">
<div class="case-cta-inner">
<h2 class="case-cta-headline">Want results like this?</h2>
<p class="case-cta-sub">I take on a small number of projects at a time. If you have something worth building, let&rsquo;s talk.</p>
<a href={`${base}contact/`} class="button">Hire Me <span class="arrow" aria-hidden="true">&#x2192;</span></a>
</div>
</div></section>
<style is:global>
.case-hero{padding-block:48px;padding-block:clamp(48px,8vw,96px) clamp(32px,4vw,48px);border-bottom:1px solid var(--border);background:var(--bg)}
.case-crumb{font-family:var(--font-mono);font-size:12px;font-weight:600;color:var(--text-dim);margin:0 0 var(--space-4);display:flex;align-items:center;gap:8px}
.case-crumb::before{content:'~/';color:var(--purple)}
.case-crumb a{color:var(--purple);text-decoration:none}
.case-crumb-sep{opacity:.6}
.case-label{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--purple);margin:0 0 var(--space-3)}
.case-label::before{content:'//';color:var(--text-dim);opacity:.5;font-size:.9em}
.case-hero-title{font-family:var(--font-mono);font-size:28px;font-size:clamp(28px,8vw,80px);font-weight:800;letter-spacing:-.03em;line-height:1.1;color:var(--text);margin-block:var(--space-4);-webkit-font-smoothing:antialiased;overflow-wrap:break-word;word-break:break-word}
.case-hero-meta{display:flex;flex-direction:column;gap:var(--space-4);margin-top:var(--space-5)}
.case-hero-tags{display:flex;flex-wrap:wrap;gap:8px;gap:var(--space-2)}
.tag{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:3px 10px;border-radius:var(--radius-sm);background:var(--purple-light);color:var(--purple);border:1px solid rgba(124,58,237,.15)}
.case-hero-details{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-5)}
.case-detail{font-family:var(--font-mono);font-size:13px;color:var(--text-mid);display:flex;flex-direction:column;gap:2px}
.case-detail-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim)}
.case-live-link{font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--purple);text-decoration:none;display:inline-flex;align-items:center;gap:4px;min-height:48px}
.case-live-link:hover{color:var(--text)}
.case-section{padding-block:48px;padding-block:clamp(48px,6vw,80px)}
.case-section--problem{background:var(--bg);border-top:1px solid var(--border)}
.case-section--solution{background:var(--surface);border-top:1px solid var(--border)}
.case-section--result{background:var(--text);border-top:1px solid var(--border)}
.case-section-header{display:flex;align-items:baseline;gap:var(--space-4);margin-bottom:var(--space-5);padding-bottom:var(--space-4);border-bottom:1px solid var(--border)}
.case-section--result .case-section-header{border-bottom-color:rgba(247,246,243,.1)}
.case-section-num{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.1em;color:var(--text-dim);min-width:28px}
.case-section--result .case-section-num{color:rgba(247,246,243,.55)}
.case-section-title{font-family:var(--font-mono);font-size:20px;font-size:clamp(20px,2.5vw,28px);font-weight:700;letter-spacing:-.02em;color:var(--text);margin:0;-webkit-font-smoothing:antialiased}
.case-section--result .case-section-title{color:#f7f6f3}
.case-prose p{font-size:16px;font-size:clamp(16px,1.8vw,18px);line-height:1.85;color:var(--text-mid);max-width:68ch;margin:0 0 var(--space-4)}
.case-prose p:last-child{margin-bottom:0}
.case-results-grid{display:grid;grid-template-columns:1fr;gap:1px;background:rgba(247,246,243,.08);border:1px solid rgba(247,246,243,.08);border-radius:var(--radius-lg);overflow:hidden;margin-top:var(--space-5)}
@media(min-width:768px){.case-results-grid{grid-template-columns:repeat(3,1fr)}}
.case-result{background:rgba(247,246,243,.02);padding:var(--space-5);display:flex;flex-direction:column;gap:6px}
.case-result-number{font-family:var(--font-mono);font-size:32px;font-size:clamp(32px,4vw,48px);font-weight:800;letter-spacing:-.04em;line-height:1;color:#f7f6f3;overflow-wrap:break-word}
.case-result-number span{background:var(--gradient-brand);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.case-result-label{font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(247,246,243,.5)}
.case-result-note{font-family:var(--font-mono);font-size:15px;color:rgba(247,246,243,.7);margin:var(--space-5) 0 0;max-width:60ch;line-height:1.8}
.case-stack-section{background:var(--surface);border-top:1px solid var(--border);padding-block:48px;padding-block:clamp(48px,6vw,80px)}
.case-stack-label{font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim);margin:0 0 var(--space-4)}
.case-stack{display:flex;flex-wrap:wrap;gap:8px;gap:var(--space-2)}
.case-stack-item{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--text-mid);background:var(--bg);border:1px solid var(--border);padding:6px 14px;border-radius:var(--radius-sm);letter-spacing:.02em}
.case-nav{background:var(--bg);border-top:1px solid var(--border);padding-block:var(--space-6) var(--space-7)}
.case-nav-eyebrow{font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim);margin:0 0 var(--space-4)}
.case-nav-inner{display:flex;flex-direction:column;gap:12px;gap:var(--space-3)}
.case-nav-link{display:flex;align-items:center;gap:12px;gap:var(--space-3);text-decoration:none;padding:12px;padding:var(--space-3);border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface);transition:border-color var(--t-fast),box-shadow var(--t-fast),transform var(--t-fast);min-width:0;overflow:hidden;min-height:64px}
@media(hover:hover) and (pointer:fine){.case-nav-link:hover{border-color:var(--purple);box-shadow:0 4px 20px rgba(124,58,237,.08);transform:translateY(-2px)}}
.case-nav-link:active{transform:translateY(0)}
.case-nav-thumb{width:88px;height:56px;flex-shrink:0;border-radius:var(--radius-sm);overflow:hidden;background:var(--bg);border:1px solid var(--border);min-width:88px}
.case-nav-thumb-fallback{display:block;width:100%;height:100%;background:linear-gradient(135deg,rgba(124,58,237,.25),rgba(0,150,78,.25))}
.case-nav-link--prev{flex-direction:row;justify-content:flex-start}
.case-nav-link--prev .case-nav-thumb{order:0}
.case-nav-link--prev .case-nav-link-text{order:1}
.case-nav-link--prev .case-nav-arrow{order:2;margin-left:auto}
.case-nav-link--next{flex-direction:row;justify-content:flex-end}
.case-nav-link--next .case-nav-arrow{order:0}
.case-nav-link--next .case-nav-link-text{order:1}
.case-nav-link--next .case-nav-thumb{order:2}
.case-nav-link-text{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1 1 auto;overflow:hidden}
.case-nav-link--next .case-nav-link-text{align-items:flex-end;text-align:right}
.case-nav-dir{font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim)}
.case-nav-title{font-family:var(--font-mono);font-size:15px;font-weight:700;color:var(--text);letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;width:100%}
.case-nav-arrow{font-size:18px;color:var(--text-dim);flex-shrink:0;min-width:18px;transition:transform var(--t-fast),color var(--t-fast)}
.case-nav-link:hover .case-nav-dir,.case-nav-link:hover .case-nav-title,.case-nav-link:hover .case-nav-arrow{color:var(--purple)}
@media(hover:hover) and (pointer:fine){.case-nav-link--prev:hover .case-nav-arrow{transform:translateX(-3px)}}
@media(hover:hover) and (pointer:fine){.case-nav-link--next:hover .case-nav-arrow{transform:translateX(3px)}}
.case-nav-all{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text);text-decoration:none;text-align:center;display:inline-flex;align-items:center;justify-content:center;gap:8px;gap:var(--space-2);padding:12px 32px;padding:var(--space-3) var(--space-5);border:1px solid var(--border);border-radius:var(--radius-full);background:var(--surface);transition:all var(--t-fast);margin-block:8px;margin-block:var(--space-2);min-height:48px}
.case-nav-all:hover{color:#fff;background:var(--text);border-color:var(--text)}
.case-nav-all-icon{font-size:14px;opacity:.7}
@media(min-width:768px){.case-nav-inner{flex-direction:row;align-items:stretch;gap:var(--space-4)}.case-nav-link,.case-nav-all{margin:0}.case-nav-link{flex:1;padding:var(--space-4)}.case-nav-title{max-width:200px}.case-nav-all{align-self:center}}
@media(min-width:1024px){.case-nav-title{max-width:280px}}
.case-cta-section{padding-block:64px;padding-block:clamp(64px,8vw,96px);background:var(--surface)}
.case-cta-inner{display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start}
.case-cta-headline{font-family:var(--font-mono);font-size:24px;font-size:clamp(24px,3.5vw,40px);font-weight:700;letter-spacing:-.03em;color:var(--text);margin:0;-webkit-font-smoothing:antialiased}
.case-cta-sub{font-size:16px;color:var(--text-dim);max-width:52ch;line-height:1.7;margin:0}
</style>
