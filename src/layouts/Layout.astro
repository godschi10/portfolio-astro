<div class="route-notice" role="dialog" aria-modal="true" aria-labelledby="route-title" aria-describedby="route-copy" hidden><h2 id="route-title">Section not available yet</h2><p id="route-copy"></p><button class="button" type="button">Close</button></div>
<script is:inline>
(() => {
 const toggle=document.querySelector('.menu-toggle'), panel=document.querySelector('.nav-mobile'), dimmer=document.querySelector('.nav-overlay'), closer=document.querySelector('.nav-mobile-close'), notice=document.querySelector('.route-notice');
 const page=[...document.body.children].filter(el=>!['SCRIPT','STYLE','NOSCRIPT'].includes(el.tagName)&&el!==panel&&el!==dimmer&&el!==notice);
 let menuOpen=false,noticeFor=null,returnTo=null;
 function controls(el){return [...el.querySelectorAll('a[href],button')].filter(x=>!x.disabled&&!x.hidden)}
 function openMenu(trigger){if(menuOpen)return;menuOpen=true;returnTo=trigger;panel.removeAttribute('inert');panel.setAttribute('aria-hidden','false');dimmer.setAttribute('aria-hidden','false');dimmer.classList.add('is-visible');page.forEach(x=>x.inert=true);document.body.style.overflow='hidden';toggle.setAttribute('aria-expanded','true');closer.focus()}
 function closeMenu(restore=true){if(!menuOpen)return;menuOpen=false;panel.setAttribute('aria-hidden','true');panel.setAttribute('inert','');dimmer.setAttribute('aria-hidden','true');dimmer.classList.remove('is-visible');page.forEach(x=>x.inert=false);document.body.style.overflow='';toggle.setAttribute('aria-expanded','false');if(restore)returnTo?.focus()}
 function openNotice(trigger,scope){closeMenu(false);noticeFor=trigger;document.querySelector('#route-copy').textContent=scope+' is not available in this staging build yet. Please email hi@gwillchijioke.com to discuss your project.';notice.hidden=false;page.forEach(x=>x.inert=true);document.body.style.overflow='hidden';controls(notice)[0]?.focus()}
 function closeNotice(){notice.hidden=true;noticeFor=null;if(!menuOpen){page.forEach(x=>x.inert=false);document.body.style.overflow=''}else{openMenu(returnTo)}}
 toggle.addEventListener('click',()=>openMenu(toggle));toggle.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openMenu(toggle)}});closer.addEventListener('click',()=>closeMenu());dimmer.addEventListener('click',()=>closeMenu());notice.querySelector('button').addEventListener('click',()=>closeNotice());
 document.querySelectorAll('[data-scope]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();openNotice(a,a.dataset.scope)}));
 panel.querySelectorAll('a:not([data-scope])').forEach(a=>a.addEventListener('click',()=>{closeMenu()}));
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!notice.hidden){e.preventDefault();closeNotice()}else if(menuOpen){e.preventDefault();closeMenu()}return}const active=!notice.hidden?notice:(menuOpen?panel:null);if(!active||e.key!=='Tab')return;const nodes=controls(active),first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}});
 document.addEventListener('focusin',e=>{const active=!notice.hidden?notice:(menuOpen?panel:null);if(active&&!active.contains(e.target))controls(active)[0]?.focus()});
 window.addEventListener('resize',()=>{if(innerWidth>=1024&&menuOpen)closeMenu()});
})();
</script>
