---
// Shared chrome: head, fonts, fixed-light palette, skip-link, header,
// compact menu + JS, route-notice, footer. Pages pass title/description.
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const fontFaces = [400, 700, 800].map(weight =>
  `@font-face{font-family:JetBrains Mono;font-style:normal;font-weight:${weight};font-display:swap;src:url("${base}fonts/jetbrains-mono-latin-${weight}-normal.woff2") format("woff2")}`
).join('\n');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="color-scheme" content="light">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="deployment" content="GitHub Pages staging — not production">
<style is:inline set:html={fontFaces}></style>
<style is:global>
@font-face{font-family:"Mono fallback";src:local("DejaVu Sans Mono");size-adjust:99.6%}
:root{color-scheme:light;--canvas:#f7f6f3;--ink:#0d0d0d;--purple:#7c3aed;--green:#00c96e;--border:#e4e2dc;--muted:#55534f;--mono:"JetBrains Mono","Mono fallback",monospace;--gradient-brand:linear-gradient(135deg,#7c3aed 0%,#00964e 100%);--wide-width:1200px;--radius-sm:4px;--t-fast:150ms ease;--t-base:200ms ease;--space-2:8px;--space-3:16px;--space-4:24px;--space-5:32px;--space-6:48px;--space-7:64px;--noise:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E")}
*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.8}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit}a{color:inherit;text-decoration:none}button,a{touch-action:manipulation}button{cursor:pointer}a:focus-visible,button:focus-visible,[tabindex="-1"]:focus-visible{outline:3px solid var(--purple);outline-offset:4px}::selection{background:var(--purple);color:white}[hidden]{display:none!important}.wrap{width:calc(100% - 32px);max-width:1312px;margin-inline:auto}.skip{position:fixed;top:8px;left:16px;transform:translateY(-160%);background:white;z-index:1000;padding:12px 16px;min-height:48px}.skip:focus{transform:none}
.site-header{position:sticky;top:0;z-index:20;background:var(--canvas);border-bottom:1px solid var(--border)}.header-inner{min-height:64px;display:flex;align-items:center;gap:8px}.brand{display:flex;align-items:center;min-height:48px;margin-right:auto;flex-shrink:0}.wordmark{position:relative;display:inline-flex;align-items:baseline;font:700 clamp(20px,2.8vw,24px)/1 var(--mono);letter-spacing:-.04em;white-space:nowrap;font-feature-settings:"kern" 1,"liga" 1,"calt" 1}.wordmark .dot{font-weight:800;color:var(--purple);margin-left:1px}.wordmark::after{content:"";position:absolute;bottom:-6px;left:0;right:0;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--purple),var(--green));opacity:.7}.desktop-nav{display:none}.button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:56px;padding:12px 24px;border:1px solid var(--ink);border-radius:4px;font:700 16px/1.5 var(--mono);background:var(--ink);color:#fff;transition:background .18s,color .18s,transform .18s}.button .arrow{transition:transform .18s}.button:hover{background:var(--purple);border-color:var(--purple)}.button:hover .arrow{transform:translateX(3px)}.button:active{transform:translateY(1px)}.button.secondary{background:transparent;color:var(--ink)}.button.secondary:hover{background:var(--ink);color:white}.header-hire{min-height:48px;padding:8px 12px;gap:8px;white-space:nowrap}.header-hire .arrow{display:none}.menu-toggle,.menu-close{width:48px;height:48px;display:grid;place-items:center;background:transparent;border:1px solid var(--ink);border-radius:4px;flex-shrink:0}.menu-toggle svg{width:24px;height:24px}.menu-toggle:hover{color:var(--purple);border-color:var(--purple)}
.nav-overlay{position:fixed;inset:0;z-index:499;background:rgba(13,13,13,.6);opacity:0;pointer-events:none;transition:opacity var(--t-base)}.nav-overlay.is-visible{opacity:1;pointer-events:auto}.nav-mobile{position:fixed;top:0;right:0;bottom:0;z-index:500;width:min(320px,85vw);background:#0d0d0d;color:#f7f6f3;padding:var(--space-7) var(--space-5) var(--space-6);display:flex;flex-direction:column;transform:translateX(100%);transition:transform 400ms ease;overflow-y:auto}.nav-mobile[aria-hidden="false"]{transform:translateX(0)}.nav-mobile-close{position:absolute;top:var(--space-4);right:var(--space-4);width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:24px;color:#f7f6f3;background:none;border:none;cursor:pointer;border-radius:var(--radius-sm)}.nav-mobile-close:focus-visible{outline:2px solid #f7f6f3;outline-offset:4px}.mobile-nav{display:flex;flex-direction:column;flex:1}.nav-mobile-list{list-style:none;margin:auto 0;padding:0;display:flex;flex-direction:column;position:relative}.nav-mobile-link{display:flex;align-items:center;gap:16px;font-family:var(--mono);font-size:20px;font-size:clamp(20px,5vw,28px);font-weight:700;letter-spacing:-.02em;color:#f7f6f3;text-decoration:none;padding-block:var(--space-3);border-bottom:1px solid rgba(247,246,243,.08);min-height:56px}.nav-mobile-list li:last-child .nav-mobile-link{border-bottom:0}.nav-mobile-index{font-size:11px;font-weight:700;color:var(--purple);opacity:.7}.nav-mobile-link--external{display:inline-flex}.nav-mobile-link--external span{color:var(--purple)}.nav-mobile-socials{display:flex;gap:var(--space-2);padding-top:var(--space-3);border-top:1px solid rgba(247,246,243,.1);margin-top:var(--space-4)}.nav-mobile-social{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:var(--radius-sm);color:#f7f6f3}.nav-mobile-cta{width:100%;justify-content:center;margin-top:var(--space-5);padding:16px;background:var(--purple);border-color:var(--purple);color:#fff;font-size:15px}.nav-mobile-cta:hover{background:#6d28d9;border-color:#6d28d9}@media(hover:hover) and (pointer:fine){.nav-mobile-link:hover{color:var(--purple);transform:translateX(var(--space-2))}.nav-mobile-social:hover{color:var(--purple);background:rgba(247,246,243,.08)}.nav-mobile-close:hover{color:var(--purple);background:rgba(247,246,243,.08)}}@media(hover:none),(pointer:coarse){.nav-mobile-link:active{color:var(--purple);transform:translateX(var(--space-2))}.nav-mobile-cta:active{opacity:.7}}.route-notice{position:fixed;inset:auto 16px 16px;z-index:200;margin:auto;max-width:640px;background:white;border:2px solid var(--purple);border-radius:6px;box-shadow:0 12px 40px #17141c26;padding:20px;color:var(--ink)}.route-notice h2{font:700 20px/1.4 var(--mono);margin:0 0 8px}.route-notice p{margin:0 0 16px}.route-notice button{min-height:48px;min-width:96px}.no-js-nav{padding:16px;display:flex;flex-wrap:wrap;gap:8px}.no-js-nav a{padding:12px;min-height:48px;text-decoration:underline}
@keyframes blink{50%{opacity:0}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(min-width:768px){.wrap{width:calc(100% - 64px)}.header-inner{gap:16px}.header-hire .arrow{display:inline}}
@media(min-width:1024px){.wrap{width:calc(100% - 96px)}.desktop-nav{display:flex;align-items:center;gap:24px;margin-right:8px}.desktop-nav a{position:relative;display:flex;align-items:center;min-height:48px;font:600 14px/1.5 var(--mono);letter-spacing:.02em}.desktop-nav a::after{content:"";position:absolute;bottom:7px;left:0;width:0;height:2px;background:var(--purple);transition:width .18s}.desktop-nav a:hover::after,.desktop-nav a:focus-visible::after{width:50%}.menu-toggle{display:none}.header-hire{font-size:13px;padding-inline:20px}}
@media(max-width:359px){.header-inner{display:grid;grid-template-columns:1fr 48px;padding-block:8px}.brand{grid-column:1;grid-row:1}.menu-toggle{grid-column:2;grid-row:1}.header-hire{grid-column:1/-1;grid-row:2}}
@media(forced-colors:active){.rank-text{background:none;color:CanvasText}.cursor{background:CanvasText}.wordmark::after{background:LinkText}}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.btn{display:inline-flex;align-items:center;gap:var(--space-2);font-family:var(--mono);font-size:14px;font-weight:700;letter-spacing:.04em;white-space:nowrap;padding:14px 28px;border-radius:var(--radius-sm);border:1px solid transparent;cursor:pointer;text-decoration:none;transition:background var(--t-base),transform var(--t-fast),box-shadow var(--t-base)}.btn:active{transform:translateY(1px)}.btn--cta{background:#0d0d0d;color:#fff;border-color:#0d0d0d;font-size:16px;padding:16px 36px}.btn--cta:hover{background:var(--purple);border-color:var(--purple)}
.footer-logo{display:inline-flex;align-items:baseline;font-family:var(--mono);font-weight:700;font-size:18px;letter-spacing:-.04em;color:#0d0d0d;text-decoration:none;position:relative;white-space:nowrap}.footer-logo::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:2px;background:var(--gradient-brand);border-radius:2px;opacity:0;transition:opacity var(--t-base)}.logo-name{color:#0d0d0d}.footer-links-section .logo-name{color:#fff}.logo-dot{color:var(--purple);font-weight:800;margin-left:1px}
.site-footer{background:#0d0d0d;color:#f7f6f3}
.footer-cta{padding-block:64px;padding-block:clamp(64px,10vw,128px);padding-bottom:96px;padding-bottom:clamp(96px,14vw,176px);border-bottom:1px solid rgba(247,246,243,.08);position:relative;overflow:hidden;background-image:var(--noise)}
.footer-cta::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:300px;background:radial-gradient(ellipse at center,rgba(124,58,237,.15) 0%,transparent 70%);pointer-events:none}
.footer-cta::after{content:attr(data-watermark);position:absolute;bottom:-.05em;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:72px;font-size:clamp(72px,14vw,190px);font-weight:800;letter-spacing:-.05em;line-height:1;color:transparent;-webkit-text-stroke:1px rgba(247,246,243,.07);white-space:nowrap;pointer-events:none;user-select:none}
.footer-cta-inner{display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--space-6);position:relative;z-index:1;max-width:var(--wide-width);margin-inline:auto;padding-inline:16px;padding-inline:clamp(16px,5vw,80px)}
.footer-cta-headline{font-family:var(--mono);font-size:28px;font-size:clamp(28px,5vw,64px);font-weight:800;color:#f7f6f3;letter-spacing:-.04em;line-height:1.1;margin:0}
.footer-cta-headline em{font-style:normal;background:var(--gradient-brand);background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:shimmer 7s linear infinite}
@keyframes shimmer{0%{background-position:200% center}100%{background-position:-200% center}}
.footer-cta-email{font-size:15px;color:rgba(247,246,243,.55);font-family:var(--mono);margin:0}
.footer-cta-email a{color:rgba(247,246,243,.7);text-decoration:none}
.footer-cta-email a:hover{color:#f7f6f3}
.footer-socials{display:flex;align-items:center;gap:var(--space-3);margin-top:var(--space-6)}
.footer-social{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:var(--radius-sm);border:1px solid rgba(247,246,243,.12);color:rgba(247,246,243,.6);transition:all var(--t-fast);background:rgba(247,246,243,.02)}
.footer-social:active{transform:translateY(0)}
.footer-social[data-brand="x"]:hover{color:#000;border-color:#fff;background:#fff}
.footer-social[data-brand="github"]:hover{color:#fff;border-color:#fff;background:#333}
.footer-social[data-brand="linkedin"]:hover{color:#fff;border-color:#0a66c2;background:#0a66c2}
.footer-social[data-brand="mail"]:hover{color:#fff;border-color:var(--purple);background:var(--purple)}
.footer-social[data-brand="tech"]:hover{color:#fff;border-color:#00964e;background:#00964e}
.footer-links-section{padding-block:48px;padding-block:clamp(48px,6vw,80px);border-bottom:1px solid rgba(247,246,243,.08)}
.footer-inner{max-width:var(--wide-width);margin-inline:auto;padding-inline:16px;padding-inline:clamp(16px,5vw,80px)}
.footer-links-section .footer-inner{display:grid;grid-template-columns:2fr 1fr 1fr;gap:var(--space-7);align-items:start}
.footer-brand .footer-logo{font-size:20px}
.footer-tagline{margin-top:var(--space-3);font-size:13px;color:rgba(247,246,243,.55);font-family:var(--mono);line-height:1.7}
.footer-nav-label{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(247,246,243,.55);margin:0 0 var(--space-3)}
.footer-nav-list{display:flex;flex-direction:column;gap:var(--space-2);list-style:none;margin:0;padding:0}
.footer-nav-list a{font-family:var(--mono);font-size:14px;color:rgba(247,246,243,.5);text-decoration:none;transition:transform var(--t-fast);display:inline-block;padding-block:10px}
.footer-bottom{padding-top:var(--space-2);padding-bottom:calc(var(--space-4) + env(safe-area-inset-bottom,0px))}
.footer-bottom .footer-inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-3);margin-top:20px;padding-block:var(--space-4)}
.footer-copy{font-family:var(--mono);font-size:13px;color:rgba(247,246,243,.55);margin:0}
.footer-legal{display:flex;gap:var(--space-4)}
.footer-legal a{font-family:var(--mono);font-size:13px;color:rgba(247,246,243,.55);text-decoration:none}
.footer-legal a:hover{color:rgba(247,246,243,.7)}
@media(max-width:767px){.footer-links-section .footer-inner{grid-template-columns:1fr;gap:var(--space-6)}.footer-cta::after{font-size:56px;font-size:clamp(56px,20vw,120px);bottom:-.08em}}
@media(hover:hover) and (pointer:fine){.footer-logo:hover::after{opacity:.7}.footer-nav-list a:hover{color:#f7f6f3;transform:translateX(4px)}.footer-social:hover{transform:translateY(-2px)}}
@media(hover:none),(pointer:coarse){.footer-nav-list a:active{color:var(--purple);transform:translateX(var(--space-2))}.btn:active{opacity:.7}}
</style>
</head>
